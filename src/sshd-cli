app_about() {
    # --- Safe Variable Defaults ---
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=sshd-cli}"
    # Version comes from global SSOT (VERSION="…" hard-assign near top); default only if unset
    : "${VERSION:=1.11.0}"
    if [ -n "${PREFIX-}" ] && [ -d "${PREFIX}/bin" ]; then
    : "${GLOBAL_BIN:=${PREFIX}/bin}"
else
    : "${GLOBAL_BIN:=/usr/local/bin}"
fi
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SCRIPT_URL:=}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"

    # Storage (requirement-shell-cli-storage): resolve if main has not yet
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"

    sshd_resolve
    SSHD_ABOUT_RUNNING="false"
    if sshd_running_pid >/dev/null 2>&1; then
        SSHD_ABOUT_RUNNING="true"
    fi
    SSHD_ABOUT_SYSTEMD="false"
    SSHD_ABOUT_UNIT=""
    SSHD_ABOUT_UNIT_ACTIVE="false"
    if sshd_is_systemd_host; then
        SSHD_ABOUT_SYSTEMD="true"
        SSHD_ABOUT_UNIT=$(sshd_systemd_unit || true)
        if [ -n "${SSHD_ABOUT_UNIT}" ] && sshd_systemd_is_active "${SSHD_ABOUT_UNIT}"; then
            SSHD_ABOUT_UNIT_ACTIVE="true"
        fi
    fi

    if [ "${JSON}" -eq 1 ]; then
        # === JSON MODE - Clean, machine-friendly output ===
        local installed="false"
        inst_is_installed && installed="true"

        local global_ver="not found"
        if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
            global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local local_ver="not found"
        if [ -x "${USER_BIN}/${APP_NAME}" ]; then
            local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi

        local current_shell
        current_shell=$(util_get_current_shell)

        local interactive="false"
        [ -t 1 ] && interactive="true"

        local current_user
        current_user="$(id -un 2>/dev/null || echo "unknown")"

        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "global_version" "${global_ver}" \
            "local_version" "${local_ver}" \
            "shell" "${current_shell}" \
            "interactive" "${interactive}" \
            "user" "${current_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "sshd_platform" "${SSHD_PLATFORM:-}" \
            "sshd_bin" "${SSHD_BIN:-}" \
            "sshd_port" "${SSHD_PORT:-}" \
            "sshd_running" "${SSHD_ABOUT_RUNNING:-false}" \
            "sshd_systemd" "${SSHD_ABOUT_SYSTEMD:-false}" \
            "sshd_unit" "${SSHD_ABOUT_UNIT:-}" \
            "sshd_unit_active" "${SSHD_ABOUT_UNIT_ACTIVE:-false}"
        return 0
    fi

    # === Normal Human-readable Mode ===
    [ "${QUIET}" -eq 1 ] && return 0

    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line

    # Installation status
    if inst_is_installed; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in your PATH."
        if [ -n "${SCRIPT_URL}" ]; then
            out_info "   Recommended: curl -fsSL ${SCRIPT_URL} | sh"
        else
            out_info "   Set SCRIPT_URL to the install script URL, then: curl -fsSL \"\${SCRIPT_URL}\" | sh"
        fi
    fi

    out_empty_line

    # Global vs Local installation details
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${global_ver}"
    else
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   not found"
    fi

    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${local_ver}"
    else
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    not found"
    fi

    out_empty_line

    local current_user
    current_user="$(id -un 2>/dev/null || echo "unknown")"
    out_info "Current user:      ${current_user}"

    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root (global install path available)"
    else
        out_info "Execution context: this login (no root required for this CLI)"
    fi

    out_empty_line

    local current_shell
    current_shell=$(util_get_current_shell)

    out_info "Current shell:     ${current_shell}"

    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no (non-interactive / scripted mode)"
    fi

    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback config field): ${STORAGE_DIR}"

    # --- DOMAIN_ABOUT_FIELDS (specializee injection) ---
    out_empty_line
    out_info "sshd platform:    ${SSHD_PLATFORM}"
    out_info "sshd binary:      ${SSHD_BIN:-not found}"
    out_info "sshd port:        ${SSHD_PORT}"
    if [ "${SSHD_ABOUT_RUNNING}" = "true" ]; then
        out_success "sshd running:     yes"
    else
        out_info "sshd running:     no"
    fi
    if [ "${SSHD_ABOUT_SYSTEMD}" = "true" ]; then
        if [ -n "${SSHD_ABOUT_UNIT}" ]; then
            out_info "sshd unit:        ${SSHD_ABOUT_UNIT} (active=${SSHD_ABOUT_UNIT_ACTIVE})"
        else
            out_info "sshd unit:        none"
        fi
    fi
    # --- end DOMAIN_ABOUT_FIELDS ---

    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help           → Full usage"
    out_info "   ${APP_NAME} self-update    → Update to latest version"
    out_info "   ${APP_NAME} self-uninstall → Clean removal from system"
    out_info "   ${APP_NAME} --json         → Machine-readable output"

    out_empty_line
    out_info "Run '${APP_NAME} help' for complete usage information."
}

app_version() {
    : "${APP_NAME:=sshd-cli}"
    : "${VERSION:=1.11.0}"
    : "${JSON:=0}"
    if [ "${JSON}" -eq 1 ]; then
        # Same machine contract as historical app_main inline path
        out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
    else
        out_info "${APP_NAME} version ${VERSION}"
    fi
}

# =============================================================================
# app_help() - Display help for selfmanaged
# =============================================================================
#
# Shows usage, available commands, and global flags.
# Fully respects --quiet and --json modes.
#
# In --json mode: returns a minimal success object instead of long text.
# In --quiet mode: prints nothing (silent).
#
# Keep in sync with requirement-shell-cli-interface.md command table.
# =============================================================================

app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Simplify Termux to install sshd}}"
    : "${DESCRIPTION:=POSIX /bin/sh CLI: simplify Termux to install and run OpenSSH sshd (status/start/stop/port/keys) plus self-install.}"

    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, version-check, install, self-update, self-uninstall, rc-test."
        return 0
    fi

    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi

    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line

    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line

    out_info "Self-management (this login):"
    out_plain "  install              Place ${APP_NAME}; ensure rc + Termux openssh/termux-auth; start sshd"
    out_plain "  version              Show current version (TTY menu 82 runs about)"
    out_plain "  about                Show detailed diagnostics"
    out_plain "  version-check        Compare local vs remote version (needs SCRIPT_URL)"
    out_plain "  self-update          Update ${APP_NAME} to a newer remote version"
    out_plain "  self-uninstall       Remove ${APP_NAME} (safe PATH cleanup)"
    out_plain "  help                 Show this help"
    out_empty_line

    # --- DOMAIN_HELP_ROWS (specializee injection) ---
    out_info "Domain commands (OpenSSH sshd):"
    out_plain "  status               Show whether sshd is running, and the port/paths (Linux systemd: unit name + active)"
    out_plain "  start                Start sshd: Termux / no-unit Linux = background daemon (sshd -f); Linux distro unit = systemctl start as root"
    out_plain "  stop                 Stop sshd (systemctl stop when a distro unit exists)"
    out_plain "  restart              Restart sshd (systemctl restart when a distro unit exists; else stop then start)"
    out_plain "  port [N]             Show or set the listen Port in sshd_config"
    out_plain "  config               Show resolved sshd paths and key settings"
    out_plain "  host-keys [list|generate]  List or create host keys"
    out_plain "  auth-keys [list|add <file>]  This login authorized_keys"
    out_plain "  dns [list|show N|edit N|set N …|add …|delete N|unset N field …]  This login ~/.ssh/config Host list (dns-ip; as Termux / identity-file / Old OpenSSH; unset drops extra settings, not dns or ip)"
    out_plain "  ssh [N|name]         OpenSSH client to a Host from this login ~/.ssh/config (TTY: numbered pick, then user with default)"
    out_plain "  download [N|name] [folder]  tar.gz a remote folder over ssh and extract it here (TTY: pick Host, then user with default, then numbered previous folders or type a path; ~/folder allowed)"
    out_plain "  upload [N|name] [folder]  tar.gz a local folder over ssh and extract it under the remote login home (TTY: pick Host, then user with default, then numbered previous local folders or type a path; ~/folder is this login)"
    out_plain "  backup-config        Copy this login ~/.ssh/config into /var/sshd-cli (passwordless sudo sshd-cli backup-config after sudoer-adm)"
    out_plain "  sync-config          Copy /var/sshd-cli/config into this login ~/.ssh/config (mode 600; no sudo)"
    out_plain "  sync-from-remote [SPEC]  Copy a remote host's /var/sshd-cli/config into this login ~/.ssh/config (scp; remembers last user@host)"
    out_plain "  print-sudoers        Emit project-sudoers-file (draft) for admin install"
    out_plain "  print-sudoers-install-script  Write admin script for sudo install/uninstall/replace"
    out_plain "  generate-sudoer-request [path]  Independently write a JSON grant (backup-config verb)"
    out_plain "  submit-sudoer-request [file]  Queue a JSON sudoers-grant request via sudoer-cli"
    out_plain "  remove-project-sudoers [path]  Delete project-sudoers-file draft only"
    out_plain "  menu                 Numbered tree: 1 client-side, 2 server-side, 8 self-management, 9 Exit. Client 11… dns/ssh/download/upload; server 21… status/start/stop/restart; self-management 81… install/version/about. Submenus 0 Back. Alias: main"
    out_empty_line
    out_info "Termux (Android wake lock):"
    out_plain "  wake-lock            Acquire the Android wake lock so sshd can keep listening with the screen off (idempotent; acquire again if Android dropped it)"
    out_plain "  wake-unlock          Release the Android wake lock (does not stop sshd; lock is Termux-wide)"
    out_empty_line
    # --- end DOMAIN_HELP_ROWS ---

    out_info "Tests (local folder; not install):"
    out_plain "  rc-test              Prove PATH/profile ensure in --root tmp (--file bashrc|profile --case create|modify|noop). Does not write this login's real ~/.bashrc"
    out_empty_line

    out_info "Global Options:"
    out_plain "  --quiet, -q          Suppress info/success (errors and warnings still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall confirm / allow downgrade"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line

    # Effective channel values (Config SSOT / env override) so help is actionable.
    # CHECKSUM is an install-path runtime pin only — never listed here (requirement-shell-automatic-checksum).
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=sshd-cli}"
    : "${SCRIPT_URL:=}"
    : "${HOME:=/tmp}"
    : "${BASHRC:=${HOME}/.bashrc}"

    out_info "Environment:"
    out_plain "  REPO_USER            ${REPO_USER}"
    out_plain "                       GitHub owner used to compose default SCRIPT_URL"
    out_plain "  REPO_NAME            ${REPO_NAME}"
    out_plain "                       GitHub repo used to compose default SCRIPT_URL"
    if [ -n "${SCRIPT_URL}" ]; then
        out_plain "  SCRIPT_URL           ${SCRIPT_URL}"
    else
        out_plain "  SCRIPT_URL           (not set)"
    fi
    out_plain "                       Canonical install channel (override via env; needed for version-check/self-update)"
    out_plain "  BASHRC               ${BASHRC}"
    out_plain "                       Interactive rc written by install PATH ensure (default \${HOME}/.bashrc; override for tests/CI)"
    out_plain "  SSHD_CLI_ROOT        durable store (default /var/sshd-cli)"
    out_plain "  SSHD_CLI_REMOTE_ROOT remote store for sync-from-remote (default /var/sshd-cli)"
    out_plain "  SSHD_CLI_SCP         scp binary override (tests inject a fake)"
    out_plain "  SSHD_CLI_SSH         ssh binary override (tests inject a fake)"
    out_empty_line
}


# =============================================================================
# app_main() - Main entrypoint and command dispatcher
# =============================================================================
#
# GENERAL PURPOSE:
# Thin dispatcher for the selfmanaged CLI (Type 0 only).
# Handles:
#   - Auto-install behavior for classic `curl | sh` one-liner (zero arguments)
#   - Global flag parsing (--quiet, --json, --debug, --force)
#   - Command routing for all Type 0 self-management commands
#
# This is the single entry point when the script is executed directly.
#
# CIAO PRINCIPLES APPLIED:
# - Caution (Principle 1): Never call undefined functions. Always use inst_is_installed.
#   Auto-install block is kept at the very top as required by existing comments.
# - Intentional (Principle 2): All supported commands from
#   requirement-shell-cli-interface.md and app_help() are recognized and routed.
# - Anti-fragile (Principle 3): Works correctly in interactive TTY, quiet, JSON,
#   and non-interactive `curl | sh` environments.
# - Over-protect (Principle 18): Explicit if/then logic, safe defaults, and centralized
#   output via out_die for unknown commands.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central command dispatcher. Changes here affect every execution path.
#
# Lessons Learned (CIAO Reflection):
# 2026-06-26:
#   - Original version called non-existent functions and only recognized
#     version/about/help; expanded routing and safe defaults.
# 2026-07-12:
#   - Wired --force → FORCE=1 and FORCE_REINSTALL=1 (requirement-shell-cli-interface).
# 2026-07-14:
#   - version routes through app_version (no dual inline path).
#   - zero-arg install propagates failure exit status.
#   - Type O empty argv: always install-ensure (not help when already installed).
#     Cases A/B/C (not installed / local / global). --force only for deliberate
#     re-download/replace — not required for a second one-liner run.
#     SSOT: requirement-shell-cli-zero-arguments.md (selfmanaged = Type O).
# 2026-08-11:
#   - Specializee injection anchors (DOMAIN_DISPATCH_*) for A→B products; empty
#     argv remains Type O — domain setup uses explicit verbs only.
# 2026-09-05:
#   - Empty argv split: interactive (TTY, not quiet/json) → domain menu;
#     non-interactive / curl|sh / quiet / json → Type O install-ensure.
#     SSOT: requirement-shell-cli-zero-arguments.md
#
# Last reviewed: 2026-09-05
# =============================================================================

app_main() {
    # --- Safe Variable Defaults ---
    : "${COMMAND:=help}"
    : "${DOMAIN_OPERANDS:=}"
    : "${RC_TEST_OPERANDS:=}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"

    # Effective scratch/cache root for this run (requirement-shell-cli-storage).
    # Chain: /dev/shm → Termux PREFIX/tmp / Git Bash AppData Temp/cache →
    # $TEMP/cache → /tmp/cache → STORAGE_DIR. mkdir of each leaf is fail-soft;
    # die only if no root worked. Export TMPDIR so mktemp -t (install download
    # stage) lands under the isolated product root.
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"

    # === ZERO-ARG ===
    # Interactive (TTY=1, not quiet/json): domain menu (sshd_cmd_menu).
    # Non-interactive (pipe / curl|sh / quiet / json / no TTY): Type O install-ensure.
    # Consume process TTY (measured once at startup). JSON/QUIET env still force install.
    # SSOT: docs/requirements/requirement-shell-cli-zero-arguments.md
    if [ $# -eq 0 ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            sshd_cmd_menu
            exit $?
        fi
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_perform_install
            exit $?
        elif inst_is_installed; then
            inst_perform_install
            exit $?
        else
            inst_maybe_install
            exit $?
        fi
    fi

    # === Argument parsing: flags and commands (order-independent) ===
    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --update)
                SUBMIT_ACTION="update"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --add)
                SUBMIT_ACTION="add"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            # --- DOMAIN_DISPATCH_FLAGS (specializee injection) ---
            # Specialized products MAY parse domain-only flags here (e.g. --no-cloudflare).
            # --- end DOMAIN_DISPATCH_FLAGS ---
            version|about|help|version-check|self-update|self-uninstall|install|rc-test)
                COMMAND="$1"
                ;;
            # --- DOMAIN_DISPATCH_COMMANDS (specializee injection) ---
            status|start|stop|restart|port|config|host-keys|auth-keys|dns|ssh|download|upload|menu|main|wake-lock|wake-unlock|backup-config|sync-config|sync-from-remote|print-sudoers|print-sudoers-install-script|generate-sudoer-request|submit-sudoer-request|remove-project-sudoers)
                case "${COMMAND}" in
                    port|host-keys|auth-keys|dns|ssh|download|upload|sync-from-remote|print-sudoers|print-sudoers-install-script|generate-sudoer-request|submit-sudoer-request|remove-project-sudoers)
                        if [ "${COMMAND}" = "dns" ] && [ -z "$1" ]; then
                            _op='""'
                        else
                            _op="$1"
                        fi
                        if [ -n "${DOMAIN_OPERANDS}" ]; then
                            DOMAIN_OPERANDS="${DOMAIN_OPERANDS} ${_op}"
                        else
                            DOMAIN_OPERANDS="${_op}"
                        fi
                        unset _op
                        ;;
                    *)
                        COMMAND="$1"
                        ;;
                esac
                ;;
            # --- end DOMAIN_DISPATCH_COMMANDS ---
            *)
                case "${COMMAND}" in
                    rc-test)
                        if [ -n "${RC_TEST_OPERANDS}" ]; then
                            RC_TEST_OPERANDS="${RC_TEST_OPERANDS} $1"
                        else
                            RC_TEST_OPERANDS="$1"
                        fi
                        ;;
                    port|host-keys|auth-keys|dns|ssh|download|upload|sync-from-remote|print-sudoers|print-sudoers-install-script|generate-sudoer-request|submit-sudoer-request|remove-project-sudoers)
                        if [ "${COMMAND}" = "dns" ] && [ -z "$1" ]; then
                            _op='""'
                        else
                            _op="$1"
                        fi
                        if [ -n "${DOMAIN_OPERANDS}" ]; then
                            DOMAIN_OPERANDS="${DOMAIN_OPERANDS} ${_op}"
                        else
                            DOMAIN_OPERANDS="${_op}"
                        fi
                        unset _op
                        ;;
                    *)
                        out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                        ;;
                esac
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE}"

    case "${COMMAND}" in
        version)
            app_version
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        install)
            inst_perform_install
            ;;
        rc-test)
            # shellcheck disable=SC2086
            set -- ${RC_TEST_OPERANDS}
            path_rc_test "$@"
            ;;
        # --- DOMAIN_DISPATCH_ROUTES (specializee injection) ---
        # No systemd / systemctl / termux-services / sv-enable / add-crontab / enable-service.
        # requirement-domain-sshd: start is OpenSSH daemonize.
        status) sshd_cmd_status ;;
        start) sshd_cmd_start ;;
        stop) sshd_cmd_stop ;;
        restart) sshd_cmd_restart ;;
        port)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_port "${1-}"
            ;;
        config) sshd_cmd_config ;;
        host-keys)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_host_keys "${1:-list}"
            ;;
        auth-keys)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_auth_keys "${1:-list}" "${2-}"
            ;;
        dns)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_dns "$@"
            ;;
        ssh)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_ssh "$@"
            ;;
        download)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_download "$@"
            ;;
        upload)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_upload "$@"
            ;;
        menu|main) sshd_cmd_menu ;;
        wake-lock) sshd_cmd_wake_lock ;;
        wake-unlock) sshd_cmd_wake_unlock ;;
        backup-config) sshd_cmd_backup_config ;;
        sync-config) sshd_cmd_sync_config ;;
        sync-from-remote)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_sync_from_remote "${1-}"
            ;;
        print-sudoers)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_print_sudoers "${1-}"
            ;;
        print-sudoers-install-script)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_print_sudoers_install_script "${1-}"
            ;;
        generate-sudoer-request)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_generate_sudoer_request "${1-}"
            ;;
        submit-sudoer-request)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_submit_sudoer_request "${1-}"
            ;;
        remove-project-sudoers)
            set -- ${DOMAIN_OPERANDS}
            sshd_cmd_remove_project_sudoers "${1-}"
            ;;
        # --- end DOMAIN_DISPATCH_ROUTES ---
        help|*)
            app_help
            ;;
    esac
}


