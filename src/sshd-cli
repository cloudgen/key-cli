sshd_cmd_sudoers_menu() {
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die "sudoers menu needs a terminal. Next: ${APP_NAME} generate-sudoer-request"
    fi
    while true; do
        out_info "$(printf '%s' "${APP_NAME}") — sudoers (grant and drafts)"
        out_menu_choice "171" "generate-sudoer-request" "Write a JSON grant you can read"
        out_menu_choice "172" "submit-sudoer-request" "Queue the JSON grant inbound"
        out_menu_choice "173" "print-sudoers" "Emit sudoers draft"
        out_menu_choice "174" "print-sudoers-install-script" "Write admin install script"
        out_menu_choice "175" "remove-project-sudoers" "Remove sudoers draft only"
        out_plain "0. Back"
        out_msg_n "Choose a number, or type the command name: "
        _sc=""
        read -r _sc || true
        case "${_sc}" in
            171|generate-sudoer-request) sshd_cmd_generate_sudoer_request; break ;;
            172|submit-sudoer-request) sshd_cmd_submit_sudoer_request; break ;;
            173|print-sudoers) sshd_cmd_print_sudoers; break ;;
