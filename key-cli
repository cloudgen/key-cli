key_list_archive_basenames() {
    _dir="${1:-}"
    if [ ! -d "${_dir}" ]; then
        unset _dir
        return 0
    fi
    _found=0
    for _f in "${_dir}"/ssh-*.tar.gz; do
        [ -f "${_f}" ] || continue
        _found=1
        printf '%s\n' "${_f##*/}"
    done
    unset _dir _f _found
}

key_elev_reexec() {
    : "${APP_NAME:=key-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${JSON:=0}"
    _verb="${1:-}"
    shift
    _bin="${GLOBAL_BIN}/${APP_NAME}"
    if [ ! -x "${_bin}" ]; then
        out_die "Cannot elevate: need the global binary ${_bin}. Next: sudo sh src/${APP_NAME} install, then ${APP_NAME} generate-sudoer-request and ${APP_NAME} submit-sudoer-request."
    fi
    if ! command -v sudo >/dev/null 2>&1; then
        out_die "sudo not found. Deposit into $(key_cli_root) needs passwordless sudo ${APP_NAME} ${_verb} after sudoer-adm approval."
    fi
    out_info "Elevating: sudo -n ${_bin} ${_verb}${*:+ $*}"
    _sudo_ec=0
    if [ "${JSON}" -eq 1 ]; then
        util_sudo "${_bin}" --json "${_verb}" "$@" >/dev/null
        _sudo_ec=$?
    else
        util_sudo "${_bin}" "${_verb}" "$@"
        _sudo_ec=$?
    fi
    if [ "${_sudo_ec}" -ne 0 ]; then
        out_die "sudo ${APP_NAME} ${_verb} was refused. Next: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request, then ask sudoer-adm to approve the JSON grant (NOPASSWD ${_bin} ${_verb})."
    fi
    unset _verb _bin _sudo_ec
    return 0
}

key_count_files() {
    _p="${1:-}"
    if [ ! -d "${_p}" ]; then
        printf '%s' "0"
        unset _p
        return 0
    fi
    _n=$(find "${_p}" -type f 2>/dev/null | wc -l | tr -d ' ')
    printf '%s' "${_n:-0}"
    unset _p _n
}

key_cmd_backup() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    # local: nested backup from add/restore must not unset the caller's _subject/_src.
    local _subject _src _dest_root _dest_dir _outp _stage _parent _base
    local _src_files _members _size _owner
    key_refuse_elev_on_nuser
    _subject=$(key_resolve_subject "${1:-}")
    _src=$(key_user_ssh_dir "${_subject}")
    _dest_root=$(key_cli_root)
    _dest_dir=$(key_archive_dir "${_subject}")
    if [ ! -d "${_src}" ]; then
        out_die "Cannot backup: missing ${_src}. Next: create that login's .ssh folder, then ${APP_NAME} backup ${_subject}."
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ] && key_dest_needs_elev "${_dest_root}"; then
        if [ -n "${1:-}" ]; then
            key_elev_reexec backup "${_subject}"
        else
            key_elev_reexec backup
        fi
        if [ "${JSON}" -eq 1 ] && [ "${KEY_NESTED_BACKUP:-0}" -ne 1 ]; then
            out_json "backup" "ok" \
                "app" "${APP_NAME}" \
                "user" "${_subject}" \
                "source" "${_src}" \
                "destination_dir" "${_dest_dir}" \
                "elevated" "true"
        fi
        unset _subject _src _dest_root _dest_dir
        return 0
    fi
    command -v tar >/dev/null 2>&1 || out_die "tar not found. Next: install tar, then ${APP_NAME} backup."
    if [ ! -d "${_dest_dir}" ]; then
        mkdir -p "${_dest_dir}" || out_die "Cannot create ${_dest_dir} (need allowlisted sudo ${APP_NAME} backup). Next: ${APP_NAME} generate-sudoer-request && ${APP_NAME} submit-sudoer-request."
    fi
    if [ ! -w "${_dest_dir}" ]; then
        out_die "Cannot write ${_dest_dir}. Only an approved passwordless sudo ${APP_NAME} backup may push archives there."
    fi
    _outp=$(key_next_archive_path "${_subject}")
    _stage=$(mktemp -t "${APP_NAME}.ssh.XXXXXX") || out_die "Could not create a stage archive."
    _parent=$(dirname -- "${_src}")
    _base=$(basename -- "${_src}")
    if [ ! -d "${_parent}" ]; then
        rm -f "${_stage}"
        out_die "Cannot backup: missing parent ${_parent}."
    fi
    if ! tar -C "${_parent}" -czf "${_stage}" "${_base}"; then
        rm -f "${_stage}"
        out_die "tar failed for ${_src}."
    fi
    if command -v install >/dev/null 2>&1; then
        install -m 0600 "${_stage}" "${_outp}" || { rm -f "${_stage}"; out_die "Failed to deposit ${_outp}."; }
    else
        cp "${_stage}" "${_outp}" || { rm -f "${_stage}"; out_die "Failed to deposit ${_outp}."; }
        chmod 0600 "${_outp}" 2>/dev/null || true
    fi
    rm -f "${_stage}"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        chown root:root "${_outp}" 2>/dev/null || true
        chmod 0600 "${_outp}" 2>/dev/null || true
        chown root:root "${_dest_dir}" 2>/dev/null || true
        chmod 0750 "${_dest_dir}" 2>/dev/null || true
        chown root:root "${_dest_root}" 2>/dev/null || true
        chmod 0755 "${_dest_root}" 2>/dev/null || true
    fi
    _src_files=$(key_count_files "${_src}")
    _members=$(tar -tzf "${_outp}" 2>/dev/null | wc -l | tr -d ' ')
    _size=$(wc -c < "${_outp}" 2>/dev/null | tr -d ' ')
    _owner="invoking-user"
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        _owner="root:root"
    fi
    KEY_LAST_BACKUP_PATH="${_outp}"
    export KEY_LAST_BACKUP_PATH
    out_success "Backup complete: ${_src} → ${_outp}"
    out_info "Verified: source_files=${_src_files} members=${_members:-0} size=${_size:-0} owner=${_owner}"
    if [ "${JSON}" -eq 1 ] && [ "${KEY_NESTED_BACKUP:-0}" -ne 1 ]; then
        out_json "backup" "ok" \
            "app" "${APP_NAME}" \
            "user" "${_subject}" \
            "source" "${_src}" \
            "destination" "${_outp}" \
            "source_files" "${_src_files}" \
            "archive_members" "${_members:-0}" \
            "archive_size" "${_size:-0}" \
            "owner" "${_owner}" \
            "verified" "true"
    fi
    return 0
}

key_resolve_archive() {
    _user="${1:-}"
    _token="${2:-}"
    _dir=$(key_archive_dir "${_user}")
    if [ -z "${_token}" ]; then
        unset _user _token _dir
        return 1
    fi
    case "${_token}" in
        */*)
            unset _user _token _dir
            return 1
            ;;
    esac
    if [ -f "${_dir}/${_token}" ]; then
        printf '%s' "${_dir}/${_token}"
        unset _user _token _dir
        return 0
    fi
    if [ -f "${_dir}/${_token}.tar.gz" ]; then
        printf '%s' "${_dir}/${_token}.tar.gz"
        unset _user _token _dir
        return 0
    fi
    _match=""
    _n=0
    for _f in "${_dir}"/ssh-*.tar.gz; do
        [ -f "${_f}" ] || continue
        _b=${_f##*/}
        case "${_b}" in
            "${_token}"*)
                _match="${_f}"
                _n=$((_n + 1))
                ;;
        esac
    done
    if [ "${_n}" -eq 1 ] && [ -n "${_match}" ]; then
        printf '%s' "${_match}"
        unset _user _token _dir _match _n _f _b
        return 0
    fi
    unset _user _token _dir _match _n _f _b
    return 1
}

key_cmd_restore() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    key_refuse_elev_on_nuser
    _a1="${1:-}"
    _a2="${2:-}"
    _self=$(key_invoking_login)
    _subject=""
    _token=""
    if [ "${_a1}" = "list" ]; then
        _subject=$(key_resolve_subject "${_a2}")
        _dir=$(key_archive_dir "${_subject}")
        _n=0
        _names=""
        for _b in $(key_list_archive_basenames "${_dir}"); do
            _n=$((_n + 1))
            if [ -z "${_names}" ]; then
                _names="${_b}"
            else
                _names="${_names} ${_b}"
            fi
            if [ "${JSON}" -eq 0 ]; then
                out_plain "${_n}. ${_b}"
            fi
        done
        if [ "${_n}" -eq 0 ]; then
            out_info "No archives for ${_subject} under ${_dir}."
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "restore-list" "ok" "user" "${_subject}" "count" "${_n}" "archives" "${_names}"
        fi
        unset _a1 _a2 _self _subject _token _dir _n _names _b
        return 0
    fi
    if [ -n "${_a1}" ] && [ -n "${_a2}" ]; then
        _subject=$(key_resolve_subject "${_a1}")
        _token="${_a2}"
    elif [ -n "${_a1}" ]; then
        case "${_a1}" in
            ssh-*.tar.gz|ssh-*)
                _subject="${_self}"
                _token="${_a1}"
                ;;
            *)
                _subject=$(key_resolve_subject "${_a1}")
                ;;
        esac
    else
        _subject="${_self}"
    fi
    _src=$(key_user_ssh_dir "${_subject}")
    _dest_root=$(key_cli_root)
    _dest_dir=$(key_archive_dir "${_subject}")
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ] && key_dest_needs_elev "${_dest_root}"; then
        if [ -n "${_a2}" ]; then
            key_elev_reexec restore "${_subject}" "${_token}"
        elif [ -n "${_a1}" ]; then
            key_elev_reexec restore "${_a1}"
        else
            key_elev_reexec restore
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "restore" "ok" "user" "${_subject}" "elevated" "true"
        fi
        unset _a1 _a2 _self _subject _token _src _dest_root _dest_dir
        return 0
    fi
    if [ -z "${_token}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            _n=0
            for _b in $(key_list_archive_basenames "${_dest_dir}"); do
                _n=$((_n + 1))
                eval "_arch_${_n}=\"${_b}\""
            done
            if [ "${_n}" -eq 0 ]; then
                out_die "No archives for ${_subject} under ${_dest_dir}. Next: ${APP_NAME} backup ${_subject}."
            fi
            while true; do
                out_info "Archives for ${_subject}:"
                _i=1
                while [ "${_i}" -le "${_n}" ]; do
                    eval "_b=\${_arch_${_i}}"
                    out_plain "${_i}. ${_b}"
                    _i=$((_i + 1))
                done
                out_plain "0. Back"
                out_msg_n "Choose an archive number: "
                _choice=""
                read -r _choice || true
                case "${_choice}" in
                    0|q|exit|"") unset _a1 _a2 _self _subject _token _src _dest_root _dest_dir _n _b _choice _i; return 0 ;;
                esac
                case "${_choice}" in
                    *[!0-9]*)
                        out_warn "Unknown restore choice '${_choice}'. Choose a number from the list."
                        continue
                        ;;
                esac
                if [ "${_choice}" -lt 1 ] || [ "${_choice}" -gt "${_n}" ]; then
                    out_warn "Unknown restore choice '${_choice}'. Choose a number from the list."
                    continue
                fi
                eval "_token=\${_arch_${_choice}}"
                break
            done
        else
            out_die "restore needs an archive name. Next: ${APP_NAME} restore list ${_subject}, then ${APP_NAME} restore ${_subject} ssh-YYYYMMDD-N.tar.gz"
        fi
    fi
    _arch=$(key_resolve_archive "${_subject}" "${_token}") || out_die "Archive not found: ${_token} under ${_dest_dir}. Next: ${APP_NAME} restore list ${_subject}."
    if [ ! -r "${_arch}" ]; then
        out_die "Cannot read ${_arch}."
    fi
    command -v tar >/dev/null 2>&1 || out_die "tar not found. Next: install tar, then ${APP_NAME} restore."
    _parent=$(dirname -- "${_src}")
    if [ ! -d "${_parent}" ]; then
        out_die "Cannot restore: missing home parent ${_parent}."
    fi
    if [ -d "${_src}" ] && [ "${FORCE}" -ne 1 ]; then
        _existing=$(key_count_files "${_src}")
        if [ "${_existing}" -gt 0 ]; then
            if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
                if ! prompt_yes_no "Replace existing ${_src}?"; then
                    out_info "Restore cancelled."
                    unset _a1 _a2 _self _subject _token _src _dest_root _dest_dir _arch _parent _existing
                    return 0
                fi
            else
                out_die "Refusing to overwrite non-empty ${_src}. Next: re-run with --force."
            fi
        fi
    fi
    if [ -d "${_src}" ]; then
        key_require_global_backup "${_subject}" 0
    fi
    mkdir -p "${_parent}" || out_die "Cannot create ${_parent}."
    tar -C "${_parent}" -xzf "${_arch}" || out_die "tar extract failed for ${_arch}."
    if [ -d "${_src}" ]; then
        chmod 0700 "${_src}" 2>/dev/null || true
        if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
            if command -v getent >/dev/null 2>&1; then
                _grp=$(getent passwd "${_subject}" 2>/dev/null | cut -d: -f4)
            else
                _grp=""
            fi
            if [ -n "${_grp}" ]; then
                chown -R "${_subject}:${_grp}" "${_src}" 2>/dev/null || chown -R "${_subject}" "${_src}" 2>/dev/null || true
            else
                chown -R "${_subject}" "${_src}" 2>/dev/null || true
            fi
        fi
    fi
    out_success "Restore complete: ${_arch} → ${_src}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "restore" "ok" \
            "app" "${APP_NAME}" \
            "user" "${_subject}" \
            "archive" "${_arch}" \
            "destination" "${_src}"
    fi
    unset _a1 _a2 _self _subject _token _src _dest_root _dest_dir _arch _parent _existing _grp _n _choice _b
    return 0
}

key_auth_keys_path() {
    _u="${1:-}"
    printf '%s' "$(key_user_ssh_dir "${_u}")/authorized_keys"
    unset _u
}

key_auth_key_inbound_dir() {
    printf '%s' "$(key_cli_root)/auth-key-request"
}

key_auth_key_accepted_dir() {
    printf '%s' "$(key_cli_root)/auth-key-accepted"
}

key_auth_key_declined_dir() {
    printf '%s' "$(key_cli_root)/auth-key-declined"
}

key_refuse_auth_key_queue_on_nuser() {
    : "${APP_NAME:=key-cli}"
    _lab=$(key_host_normal_user_only_label)
    if [ -z "${_lab}" ]; then
        unset _lab
        return 0
    fi
    out_die "auth-key requests are not available for ${_lab}. Next: use a POSIX Linux host."
}

key_auth_key_json_string_field() {
    local _ak_file _ak_name _ak_val
    _ak_file="${1-}"
    _ak_name="${2-}"
    _ak_val=""
    if [ -z "${_ak_file}" ] || [ -z "${_ak_name}" ] || [ ! -f "${_ak_file}" ]; then
        unset _ak_file _ak_name _ak_val
        return 1
    fi
    _ak_val=$(sed -n "s/.*\"${_ak_name}\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "${_ak_file}" | head -n 1)
    printf '%s' "${_ak_val}"
    unset _ak_file _ak_name _ak_val
}

key_auth_key_pubkey_from_file() {
    local _ak_file _ak_key
    _ak_file="${1-}"
    _ak_key=""
    if [ -z "${_ak_file}" ] || [ ! -f "${_ak_file}" ] || [ ! -r "${_ak_file}" ]; then
        unset _ak_file _ak_key
        return 1
    fi
    _ak_key=$(grep -E '^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp|sk-ssh-)' "${_ak_file}" | head -n 1 || true)
    _ak_key=$(printf '%s' "${_ak_key}" | tr -d '\r')
    case "${_ak_key}" in
        *\"*|*'\\'*|"")
            unset _ak_file _ak_key
            return 1
            ;;
    esac
    printf '%s' "${_ak_key}"
    unset _ak_file _ak_key
    return 0
}

key_auth_key_valid_basename() {
    local _ak_b
    _ak_b="${1-}"
    case "${_ak_b}" in
        ""|*/*|*..*|*[[:space:]]*)
            unset _ak_b
            return 1
            ;;
    esac
    case "${_ak_b}" in
        authkey-????????-*-*-add-*.json)
            unset _ak_b
            return 0
            ;;
    esac
    unset _ak_b
    return 1
}

key_auth_key_next_path() {
    local _ak_subject _ak_submitter _ak_in _ak_acc _ak_dec _ak_day _ak_n _ak_base
    _ak_subject="${1-}"
    _ak_submitter="${2-}"
    _ak_in=$(key_auth_key_inbound_dir)
    _ak_acc=$(key_auth_key_accepted_dir)
    _ak_dec=$(key_auth_key_declined_dir)
    _ak_day=$(date +%Y%m%d)
    _ak_n=1
    _ak_base=""
    while :; do
        _ak_base="authkey-${_ak_day}-${_ak_subject}-${_ak_submitter}-add-${_ak_n}.json"
        if [ ! -e "${_ak_in}/${_ak_base}" ] && [ ! -e "${_ak_acc}/${_ak_base}" ] && [ ! -e "${_ak_dec}/${_ak_base}" ]; then
            printf '%s' "${_ak_in}/${_ak_base}"
            unset _ak_subject _ak_submitter _ak_in _ak_acc _ak_dec _ak_day _ak_n _ak_base
            return 0
        fi
        _ak_n=$((_ak_n + 1))
        if [ "${_ak_n}" -gt 9999 ]; then
            unset _ak_subject _ak_submitter _ak_in _ak_acc _ak_dec _ak_day _ak_n _ak_base
            return 1
        fi
    done
}

key_auth_key_write_json() {
    local _ak_path _ak_subject _ak_submitter _ak_key
    _ak_path="${1-}"
    _ak_subject="${2-}"
    _ak_submitter="${3-}"
    _ak_key="${4-}"
    : "${APP_NAME:=key-cli}"
    : "${VERSION:=2.1.1}"
    printf '%s\n' "{\"schema_version\":1,\"purpose\":\"Allow ${_ak_submitter} to SSH as ${_ak_subject}.\",\"username\":\"${_ak_subject}\",\"submitter\":\"${_ak_submitter}\",\"service\":\"${APP_NAME}\",\"kind\":\"auth-key\",\"action\":\"add\",\"submit_app\":\"${APP_NAME}\",\"submit_version\":\"${VERSION}\",\"public_key\":\"${_ak_key}\"}" >"${_ak_path}" || return 1
    chmod 0644 "${_ak_path}" 2>/dev/null || true
    unset _ak_path _ak_subject _ak_submitter _ak_key
    return 0
}

# Return 0 if inbound JSON is a regular file matching this product schema.
# On failure print a short human reason on stdout (for interactive fence-first).
key_auth_key_validate_file() {
    local _ak_file _ak_base _ak_ver _ak_svc _ak_kind _ak_act _ak_subject _ak_submitter _ak_key _ak_sapp _ak_sver
    _ak_file="${1-}"
    _ak_base=$(basename -- "${_ak_file}" 2>/dev/null || true)
    if [ -z "${_ak_file}" ] || [ ! -e "${_ak_file}" ]; then
        printf '%s' "missing inbound file"
        return 1
    fi
    if [ -L "${_ak_file}" ] || [ ! -f "${_ak_file}" ]; then
        printf '%s' "not a regular file"
        return 1
    fi
    if ! key_auth_key_valid_basename "${_ak_base}"; then
        printf '%s' "invalid basename"
        return 1
    fi
    _ak_ver=$(sed -n 's/.*"schema_version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "${_ak_file}" | head -n 1)
    _ak_svc=$(key_auth_key_json_string_field "${_ak_file}" "service")
    _ak_kind=$(key_auth_key_json_string_field "${_ak_file}" "kind")
    _ak_act=$(key_auth_key_json_string_field "${_ak_file}" "action")
    _ak_subject=$(key_auth_key_json_string_field "${_ak_file}" "username")
    _ak_submitter=$(key_auth_key_json_string_field "${_ak_file}" "submitter")
    _ak_key=$(key_auth_key_json_string_field "${_ak_file}" "public_key")
    _ak_sapp=$(key_auth_key_json_string_field "${_ak_file}" "submit_app")
    _ak_sver=$(key_auth_key_json_string_field "${_ak_file}" "submit_version")
    if [ "${_ak_ver}" != "1" ] || [ "${_ak_svc}" != "key-cli" ] || [ "${_ak_kind}" != "auth-key" ] || [ "${_ak_act}" != "add" ]; then
        printf '%s' "schema, service, kind, or action"
        return 1
    fi
    if ! key_valid_username "${_ak_subject}" || ! key_valid_username "${_ak_submitter}"; then
        printf '%s' "username or submitter"
        return 1
    fi
    if [ -z "${_ak_sapp}" ] || [ -z "${_ak_sver}" ]; then
        printf '%s' "missing submit_app or submit_version"
        return 1
    fi
    case "${_ak_key}" in
        ssh-rsa\ *|ssh-ed25519\ *|ecdsa-sha2-nistp*\ *|sk-ssh-*)
            ;;
        *)
            printf '%s' "public_key"
            return 1
            ;;
    esac
    case "${_ak_key}" in
        *\"*|*'\\'*)
            printf '%s' "public_key quote"
            return 1
            ;;
    esac
    unset _ak_file _ak_base _ak_ver _ak_svc _ak_kind _ak_act _ak_subject _ak_submitter _ak_key _ak_sapp _ak_sver
    return 0
}

key_auth_key_take_then_move() {
    local _ak_src _ak_dest _ak_owner
    _ak_src="${1-}"
    _ak_dest="${2-}"
    _ak_owner=$(key_adm_user)
    if [ -z "${_ak_src}" ] || [ -z "${_ak_dest}" ] || [ ! -e "${_ak_src}" ]; then
        return 1
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        chown "${_ak_owner}" "${_ak_src}" || return 1
    elif [ "$(key_invoking_login)" = "${_ak_owner}" ]; then
        chown "${_ak_owner}" "${_ak_src}" 2>/dev/null || true
    else
        return 1
    fi
    mv "${_ak_src}" "${_ak_dest}" || return 1
    unset _ak_src _ak_dest _ak_owner
    return 0
}

key_auth_key_review_elev() {
    : "${APP_NAME:=key-cli}"
    local _ak_sub _ak_in
    _ak_sub="${1-}"
    shift
    if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ]; then
        unset _ak_sub
        return 0
    fi
    if ! key_can_on_behalf; then
        out_die "Cannot review auth-key requests. Next: run as $(key_adm_user) (or root)."
    fi
    _ak_in=$(key_auth_key_inbound_dir)
    if key_dest_needs_elev "${_ak_in}"; then
        key_elev_reexec auth-keys "${_ak_sub}" "$@"
        unset _ak_sub _ak_in
        return 2
    fi
    unset _ak_sub _ak_in
    return 0
}

key_cmd_auth_keys_request() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    local _ak_subject _ak_file _ak_self _ak_key _ak_in _ak_path
    key_refuse_auth_key_queue_on_nuser
    _ak_subject="${1-}"
    _ak_file="${2-}"
    _ak_self=$(key_invoking_login)
    if [ -z "${_ak_subject}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            out_msg_n "username to receive the public key: "
            read -r _ak_subject || true
        fi
    fi
    if [ -z "${_ak_file}" ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            out_msg_n "public-key file: "
            read -r _ak_file || true
        fi
    fi
    if [ -z "${_ak_subject}" ] || [ -z "${_ak_file}" ]; then
        out_die "auth-keys request needs a username and a public-key file. Example: ${APP_NAME} auth-keys request bob ./id_ed25519.pub"
    fi
    if ! key_valid_username "${_ak_subject}"; then
        out_die "Invalid username '${_ak_subject}'. Use a login name with letters, digits, dot, underscore, or hyphen."
    fi
    if [ ! -f "${_ak_file}" ] || [ ! -r "${_ak_file}" ]; then
        out_die "Cannot read public-key file: ${_ak_file}"
    fi
    _ak_key=$(key_auth_key_pubkey_from_file "${_ak_file}") || _ak_key=""
    if [ -z "${_ak_key}" ]; then
        out_die "No SSH public key line found in ${_ak_file} (or the line contains a quote / backslash)."
    fi
    _ak_in=$(key_auth_key_inbound_dir)
    if [ ! -d "${_ak_in}" ]; then
        out_die "Auth-key request inbound is missing (${_ak_in}). Next: sudo ${APP_NAME} setup"
    fi
    if [ ! -w "${_ak_in}" ]; then
        out_die "Auth-key request inbound is not writable: ${_ak_in}. Next: sudo ${APP_NAME} setup"
    fi
    _ak_path=$(key_auth_key_next_path "${_ak_subject}" "${_ak_self}") || out_die "Cannot allocate an auth-key request name."
    key_auth_key_write_json "${_ak_path}" "${_ak_subject}" "${_ak_self}" "${_ak_key}" \
        || out_die "Cannot write ${_ak_path}"
    out_success "Queued auth-key request $(basename -- "${_ak_path}")"
    out_info "Subject: ${_ak_subject}  Submitter: ${_ak_self}"
    out_info "key-adm reviews with: ${APP_NAME} auth-keys pending"
    if [ "${JSON}" -eq 1 ]; then
        out_json "auth-keys-request" "queued" \
            "path" "${_ak_path}" \
            "username" "${_ak_subject}" \
            "submitter" "${_ak_self}"
    fi
    unset _ak_subject _ak_file _ak_self _ak_key _ak_in _ak_path
    return 0
}

key_cmd_auth_keys_pending() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    local _ak_el _ak_in _ak_count _ak_names _ak_f _ak_b _ak_u _ak_s
    key_refuse_auth_key_queue_on_nuser
    key_auth_key_review_elev pending
    _ak_el=$?
    if [ "${_ak_el}" -eq 2 ]; then
        unset _ak_el
        return 0
    fi
    _ak_in=$(key_auth_key_inbound_dir)
    if [ ! -d "${_ak_in}" ]; then
        out_die "Auth-key request inbound is missing (${_ak_in}). Next: sudo ${APP_NAME} setup"
    fi
    _ak_count=0
    _ak_names=""
    for _ak_f in "${_ak_in}"/authkey-*.json; do
        [ -f "${_ak_f}" ] || continue
        _ak_b=$(basename -- "${_ak_f}")
        _ak_count=$((_ak_count + 1))
        if [ -z "${_ak_names}" ]; then
            _ak_names="${_ak_b}"
        else
            _ak_names="${_ak_names} ${_ak_b}"
        fi
        if [ "${JSON}" -eq 0 ]; then
            _ak_u=$(key_auth_key_json_string_field "${_ak_f}" "username")
            _ak_s=$(key_auth_key_json_string_field "${_ak_f}" "submitter")
            out_plain "${_ak_b}  subject=${_ak_u}  submitter=${_ak_s}"
        fi
    done
    if [ "${JSON}" -eq 1 ]; then
        out_json "auth-keys-pending" "" \
            "inbound" "${_ak_in}" \
            "count" "${_ak_count}" \
            "names" "${_ak_names}"
    else
        if [ "${_ak_count}" -eq 0 ]; then
            out_info "No pending auth-key requests in ${_ak_in}."
        else
            out_info "Pending auth-key requests: ${_ak_count}"
        fi
    fi
    unset _ak_el _ak_in _ak_count _ak_names _ak_f _ak_b _ak_u _ak_s
    return 0
}

key_cmd_auth_keys_approve() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    local _ak_base _ak_el _ak_in _ak_acc _ak_src _ak_why _ak_subject _ak_submitter _ak_key _ak_tmp _ak_save_json _ak_save_quiet
    key_refuse_auth_key_queue_on_nuser
    _ak_base="${1-}"
    if [ -z "${_ak_base}" ]; then
        out_die "auth-keys approve needs a request basename. Example: ${APP_NAME} auth-keys approve authkey-20260916-bob-alice-add-1.json"
    fi
    if ! key_auth_key_valid_basename "${_ak_base}"; then
        out_die "Invalid auth-key request name '${_ak_base}'. Use the inbound basename only."
    fi
    key_auth_key_review_elev approve "${_ak_base}"
    _ak_el=$?
    if [ "${_ak_el}" -eq 2 ]; then
        unset _ak_el _ak_base
        return 0
    fi
    _ak_in=$(key_auth_key_inbound_dir)
    _ak_acc=$(key_auth_key_accepted_dir)
    _ak_src="${_ak_in}/${_ak_base}"
    _ak_why=$(key_auth_key_validate_file "${_ak_src}")
    _ak_el=$?
    if [ "${_ak_el}" -ne 0 ]; then
        out_die "Auth-key request ${_ak_base} failed re-validation (${_ak_why:-incorrect JSON format})."
    fi
    _ak_subject=$(key_auth_key_json_string_field "${_ak_src}" "username")
    _ak_submitter=$(key_auth_key_json_string_field "${_ak_src}" "submitter")
    _ak_key=$(key_auth_key_json_string_field "${_ak_src}" "public_key")
    if [ ! -d "${_ak_acc}" ]; then
        out_die "Auth-key accepted folder is missing (${_ak_acc}). Next: sudo ${APP_NAME} setup"
    fi
    _ak_tmp=$(mktemp -t "${APP_NAME}.authkey.XXXXXX") || out_die "Could not stage the public key."
    printf '%s\n' "${_ak_key}" >"${_ak_tmp}" || { rm -f "${_ak_tmp}"; out_die "Cannot write staged public key."; }
    _ak_save_json="${JSON}"
    _ak_save_quiet="${QUIET}"
    JSON=0
    QUIET=1
    key_cmd_auth_keys add "${_ak_subject}" "${_ak_tmp}"
    JSON="${_ak_save_json}"
    QUIET="${_ak_save_quiet}"
    rm -f "${_ak_tmp}"
    key_auth_key_take_then_move "${_ak_src}" "${_ak_acc}/${_ak_base}" \
        || out_die "Appended the key but could not take ownership and move ${_ak_base} to accepted."
    out_success "Approved ${_ak_base}: appended public key for ${_ak_subject} (submitter ${_ak_submitter})."
    if [ "${JSON}" -eq 1 ]; then
        out_json "auth-keys-approve" "accepted" \
            "basename" "${_ak_base}" \
            "username" "${_ak_subject}" \
            "submitter" "${_ak_submitter}" \
            "accepted" "${_ak_acc}/${_ak_base}"
    fi
    unset _ak_base _ak_el _ak_in _ak_acc _ak_src _ak_ver _ak_svc _ak_act _ak_subject _ak_submitter _ak_key _ak_tmp _ak_save_json _ak_save_quiet
    return 0
}

key_cmd_auth_keys_reject() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    local _ak_base _ak_el _ak_in _ak_dec _ak_src
    key_refuse_auth_key_queue_on_nuser
    _ak_base="${1-}"
    if [ -z "${_ak_base}" ]; then
        out_die "auth-keys reject needs a request basename. Example: ${APP_NAME} auth-keys reject authkey-20260916-bob-alice-add-1.json"
    fi
    if ! key_auth_key_valid_basename "${_ak_base}"; then
        out_die "Invalid auth-key request name '${_ak_base}'. Use the inbound basename only."
    fi
    key_auth_key_review_elev reject "${_ak_base}"
    _ak_el=$?
    if [ "${_ak_el}" -eq 2 ]; then
        unset _ak_el _ak_base
        return 0
    fi
    _ak_in=$(key_auth_key_inbound_dir)
    _ak_dec=$(key_auth_key_declined_dir)
    _ak_src="${_ak_in}/${_ak_base}"
    if [ -L "${_ak_src}" ] || [ ! -f "${_ak_src}" ]; then
        out_die "Auth-key request not a regular inbound file: ${_ak_base}"
    fi
    if [ ! -d "${_ak_dec}" ]; then
        out_die "Auth-key declined folder is missing (${_ak_dec}). Next: sudo ${APP_NAME} setup"
    fi
    key_auth_key_take_then_move "${_ak_src}" "${_ak_dec}/${_ak_base}" \
        || out_die "Cannot take ownership and move ${_ak_base} to declined."
    out_success "Rejected ${_ak_base}."
    if [ "${JSON}" -eq 1 ]; then
        out_json "auth-keys-reject" "declined" \
            "basename" "${_ak_base}" \
            "declined" "${_ak_dec}/${_ak_base}"
    fi
    unset _ak_base _ak_el _ak_in _ak_dec _ak_src
    return 0
}

key_cmd_auth_keys_interactive() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${TTY:=0}"
    local _ak_el _ak_in _ak_any _ak_f _ak_b _ak_u _ak_s _ak_k _ak_why
    key_refuse_auth_key_queue_on_nuser
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die "auth-keys interactive needs a terminal. Next: ${APP_NAME} auth-keys pending, then ${APP_NAME} auth-keys approve <basename>."
    fi
    key_auth_key_review_elev interactive
    _ak_el=$?
    if [ "${_ak_el}" -eq 2 ]; then
        unset _ak_el
        return 0
    fi
    _ak_in=$(key_auth_key_inbound_dir)
    if [ ! -d "${_ak_in}" ]; then
        out_die "Auth-key request inbound is missing (${_ak_in}). Next: sudo ${APP_NAME} setup"
    fi
    _ak_any=0
    for _ak_f in "${_ak_in}"/authkey-*.json; do
        [ -e "${_ak_f}" ] || continue
        _ak_any=1
        _ak_b=$(basename -- "${_ak_f}")
        _ak_why=$(key_auth_key_validate_file "${_ak_f}")
        if [ $? -ne 0 ]; then
            out_warn "Incorrect JSON format for ${_ak_b}: ${_ak_why}. Skipping yes/no."
            continue
        fi
        _ak_u=$(key_auth_key_json_string_field "${_ak_f}" "username")
        _ak_s=$(key_auth_key_json_string_field "${_ak_f}" "submitter")
        _ak_k=$(key_auth_key_json_string_field "${_ak_f}" "public_key")
        out_info "Request ${_ak_b}"
        out_plain "  subject=${_ak_u}  submitter=${_ak_s}"
        out_plain "  public_key=${_ak_k}"
        if prompt_yes_no "Approve this request"; then
            key_cmd_auth_keys_approve "${_ak_b}"
        else
            key_cmd_auth_keys_reject "${_ak_b}"
        fi
    done
    if [ "${_ak_any}" -eq 0 ]; then
        out_info "No pending auth-key requests in ${_ak_in}."
    fi
    key_review_approver_login_rc
    unset _ak_el _ak_in _ak_any _ak_f _ak_b _ak_u _ak_s _ak_k
    return 0
}

key_cmd_auth_keys() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    _sub="${1:-list}"
    _a2="${2-}"
    _a3="${3-}"
    _self=$(key_invoking_login)
    _subject="${_self}"
    _file=""
    case "${_sub}" in
        list|"")
            if [ -n "${_a2}" ]; then
                _subject=$(key_resolve_subject "${_a2}")
            fi
            _dir=$(key_user_ssh_dir "${_subject}")
            _path=$(key_auth_keys_path "${_subject}")
            if [ "${_subject}" != "${_self}" ] && [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
                key_elev_reexec auth-keys list "${_subject}"
                unset _sub _a2 _a3 _self _subject _file _dir _path
                return 0
            fi
            if [ ! -f "${_path}" ]; then
                if [ "${JSON}" -eq 1 ]; then
                    out_json "auth-keys" "" "path" "${_path}" "user" "${_subject}" "count" "0"
                else
                    out_info "No authorized_keys file yet at ${_path}."
                    out_info "Add one with: ${APP_NAME} auth-keys add /path/to/id_ed25519.pub"
                fi
                unset _sub _a2 _a3 _self _subject _file _dir _path
                return 0
            fi
            _count=$(grep -cve '^[[:space:]]*$' "${_path}" 2>/dev/null || echo 0)
            if [ "${JSON}" -eq 1 ]; then
                out_json "auth-keys" "" "path" "${_path}" "user" "${_subject}" "count" "${_count}"
            else
                out_info "authorized_keys (${_path}): ${_count} line(s)"
                grep -v '^[[:space:]]*$' "${_path}" 2>/dev/null | while IFS= read -r _line; do
                    out_plain "  ${_line}"
                done
            fi
            unset _sub _a2 _a3 _self _subject _file _dir _path _count
            return 0
            ;;
        add)
            if [ -n "${_a3}" ]; then
                _subject=$(key_resolve_subject "${_a2}")
                _file="${_a3}"
            else
                _file="${_a2}"
                _subject="${_self}"
            fi
            if [ -z "${_file}" ]; then
                if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
                    out_msg_n "public-key file: "
                    read -r _file || true
                fi
            fi
            if [ -z "${_file}" ]; then
                out_die "auth-keys add needs a public-key file path. Example: ${APP_NAME} auth-keys add ./id_ed25519.pub"
            fi
            if [ ! -f "${_file}" ] || [ ! -r "${_file}" ]; then
                out_die "Cannot read public-key file: ${_file}"
            fi
            if [ "${_subject}" != "${_self}" ] && [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
                _dir=$(key_user_ssh_dir "${_subject}")
                if key_dest_needs_elev "${_dir}"; then
                    key_elev_reexec auth-keys add "${_subject}" "${_file}"
                    unset _sub _a2 _a3 _self _subject _file _dir
                    return 0
                fi
            fi
            _dir=$(key_user_ssh_dir "${_subject}")
            _path=$(key_auth_keys_path "${_subject}")
            key_require_global_backup "${_subject}" 1
            mkdir -p "${_dir}" || out_die "Could not create ${_dir}."
            chmod 700 "${_dir}" 2>/dev/null || true
            _key=$(grep -E '^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp|sk-ssh-)' "${_file}" | head -n 1 || true)
            if [ -z "${_key}" ]; then
                out_die "No SSH public key line found in ${_file}."
            fi
            touch "${_path}" || out_die "Could not create ${_path}."
            chmod 600 "${_path}" 2>/dev/null || true
            if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] && [ "${_subject}" != "root" ]; then
                chown "${_subject}" "${_dir}" "${_path}" 2>/dev/null || true
            fi
            if grep -Fqx "${_key}" "${_path}" 2>/dev/null; then
                if [ "${JSON}" -eq 1 ]; then
                    out_json "out_success" "Key already present." "path" "${_path}" "user" "${_subject}" "backup" "${KEY_LAST_BACKUP_PATH:-}"
                else
                    out_success "That key is already in ${_path}."
                fi
                unset _sub _a2 _a3 _self _subject _file _dir _path _key
                return 0
            fi
            printf '%s\n' "${_key}" >> "${_path}" || out_die "Could not append to ${_path}."
            key_require_global_backup "${_subject}" 0
            if [ "${JSON}" -eq 1 ]; then
                out_json "out_success" "Key added." "path" "${_path}" "user" "${_subject}" "backup" "${KEY_LAST_BACKUP_PATH:-}"
            else
                out_success "Added the key to ${_path}."
            fi
            unset _sub _a2 _a3 _self _subject _file _dir _path _key
            return 0
            ;;
        request)
            key_cmd_auth_keys_request "${_a2}" "${_a3}"
            unset _sub _a2 _a3 _self _subject _file
            return 0
            ;;
        pending)
            key_cmd_auth_keys_pending
            unset _sub _a2 _a3 _self _subject _file
            return 0
            ;;
        approve)
            key_cmd_auth_keys_approve "${_a2}"
            unset _sub _a2 _a3 _self _subject _file
            return 0
            ;;
        reject)
            key_cmd_auth_keys_reject "${_a2}"
            unset _sub _a2 _a3 _self _subject _file
            return 0
            ;;
        interactive)
            key_cmd_auth_keys_interactive
            unset _sub _a2 _a3 _self _subject _file
            return 0
            ;;
        *)
            out_die "Unknown auth-keys action '${_sub}'. Use list, add [user] <pubkey-file>, request [user] <pubkey-file>, pending, approve <basename>, reject <basename>, or interactive."
            ;;
    esac
}

key_cmd_print_sudoers() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${ALLOW_TEST_LOCAL_SUDOERS:=0}"
    key_refuse_elev_on_nuser
    _out_path="${1:-}"
    _tier=$(key_sudoers_trust_tier)
    _global_path="${GLOBAL_BIN:-/usr/local/bin}/${APP_NAME}"
    if [ "${_tier}" != "production" ]; then
        if [ "${ALLOW_TEST_LOCAL_SUDOERS}" -ne 1 ]; then
            out_die "print-sudoers trust tier is ${_tier} (not production). Prefer: sudo ${APP_NAME} install (global ${_global_path}). To emit a test fragment anyway: ${APP_NAME} print-sudoers --allow-test-local [path] or ALLOW_TEST_LOCAL_SUDOERS=1"
        fi
        if [ "${JSON}" -eq 0 ]; then
            out_warn "TEST MODE ONLY: trust tier=${_tier}. Prefer global install for production."
        fi
    fi
    _installed=$(key_default_installed_sudoers_path)
    _fragment=$(key_sudoers_fragment_text)
    if [ -n "${_out_path}" ]; then
        _dir=$(dirname -- "${_out_path}")
        if [ ! -d "${_dir}" ]; then
            mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
        fi
        printf '%s\n' "${_fragment}" > "${_out_path}" || out_die "Cannot write ${_out_path}"
        out_success "Wrote sudoers fragment to ${_out_path}"
        out_info "Admin: sudo visudo -c -f ${_out_path}"
        out_info "Admin: sudo install -m 0440 ${_out_path} ${_installed}"
        if [ "${JSON}" -eq 1 ]; then
            out_json "print-sudoers" "written" \
                "path" "${_out_path}" \
                "installed_path" "${_installed}" \
                "trust_tier" "${_tier}"
        fi
        unset _out_path _tier _global_path _installed _fragment _dir
        return 0
    fi
    if [ "${JSON}" -eq 1 ]; then
        out_json "print-sudoers" "use human mode or path arg to capture fragment" \
            "installed_path" "${_installed}" \
            "trust_tier" "${_tier}"
        unset _out_path _tier _global_path _installed _fragment
        return 0
    fi
    out_info "Sudoers fragment for $(key_current_login_user) → ${_global_path} backup/restore (trust_tier=${_tier})"
    out_plain "${_fragment}"
    out_info "Tip: ${APP_NAME} print-sudoers $(key_default_project_sudoers_path)"
    unset _out_path _tier _global_path _installed _fragment
    return 0
}

key_cmd_generate_sudoer_request() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${HOME:=/tmp}"
    : "${SUBMIT_ACTION:=add}"
    key_refuse_elev_on_nuser
    key_sudoers_require_emit_trust "generate-sudoer-request"
    _out_path="${1:-}"
    if [ -z "${_out_path}" ]; then
        _out_path=$(key_default_sudoer_request_path)
    fi
    case "${_out_path}" in
        /etc|/etc/*)
            out_die "generate-sudoer-request refuses to write under /etc (Type 0). Use a path under \$HOME or /dev/shm."
            ;;
        /var/sudoer-cli|/var/sudoer-cli/*)
            out_die "generate-sudoer-request does not write inbound. Write a local file, then: ${APP_NAME} submit-sudoer-request <path>"
            ;;
    esac
    _dir=$(dirname -- "${_out_path}")
    if [ ! -d "${_dir}" ]; then
        mkdir -p "${_dir}" || out_die "Cannot create ${_dir}"
    fi
    key_sudoers_json_text_compact >"${_out_path}" || out_die "Cannot write ${_out_path}"
    chmod 0644 "${_out_path}" 2>/dev/null || true
    key_sudoers_refuse_forbidden_grant "${_out_path}"
    key_sudoers_verify_grant_verbs "${_out_path}"
    out_success "Wrote verified sudoer file to ${_out_path}"
    out_info "Grant allows: ${APP_NAME} backup and restore (action=${SUBMIT_ACTION})"
    out_info "Review the file, then: ${APP_NAME} submit-sudoer-request ${_out_path}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "generate-sudoer-request" "written" \
            "path" "${_out_path}" \
            "action" "${SUBMIT_ACTION}" \
            "user" "$(key_current_login_user)"
    fi
    unset _out_path _dir
    return 0
}

key_cmd_submit_sudoer_request() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    key_refuse_elev_on_nuser
    _src_file="${1:-}"
    _cli=""
    if _cli=$(key_detect_sudoer_cli); then
        :
    else
        out_die "sudoer-cli not found (set SUDOER_CLI or install sudoer-cli). Submit is Type 0 compose — this CLI does not write /etc. Next: ${APP_NAME} generate-sudoer-request, then install sudoer-cli, then ${APP_NAME} submit-sudoer-request."
    fi
    _adm=""
    if _adm=$(key_detect_sudoer_adm); then
        :
    else
        out_die "sudoer-adm not found (id ${SUDOER_ADM_USER:-sudoer-adm} failed). Ask an admin to run: sudo sudoer-cli setup"
    fi
    _inbound=""
    if _inbound=$(key_detect_sudoer_inbound); then
        :
    else
        out_die "sudoer inbound queue not found (preferred /var/sudoer-cli/sudoer-request). Ask an admin to run: sudo sudoer-cli setup"
    fi
    if [ ! -w "${_inbound}" ]; then
        out_die "sudoer inbound not writable: ${_inbound}."
    fi
    _tmp=""
    _cleanup_tmp=0
    if [ -n "${_src_file}" ]; then
        if [ ! -f "${_src_file}" ]; then
            out_die "sudoers file not found: ${_src_file}"
        fi
        _tmp="${_src_file}"
    else
        key_sudoers_require_emit_trust "submit-sudoer-request"
        _tmp=$(mktemp -t "${APP_NAME}.sudoer.XXXXXX") || out_die "Could not create a temp sudoer file."
        key_sudoers_json_text_compact >"${_tmp}" || out_die "cannot write temp sudoer JSON ${_tmp}"
        _cleanup_tmp=1
    fi
    key_sudoers_refuse_forbidden_grant "${_tmp}"
    key_sudoers_verify_grant_verbs "${_tmp}"
    _purpose="${SUBMIT_PURPOSE:-Allow $(key_current_login_user) to run ${APP_NAME} backup and restore as root.}"
    _verb="add-sudoer-request"
    if [ "${SUBMIT_ACTION}" = "update" ]; then
        _verb="update-sudoer-request"
    fi
    _errf=$(mktemp -t "${APP_NAME}.sudoer-err.XXXXXX") || _errf="/dev/null"
    _out=""
    _rc=0
    if [ "${JSON}" -eq 1 ]; then
        _out=$("${_cli}" --json "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    else
        _out=$("${_cli}" "${_verb}" --file "${_tmp}" --purpose "${_purpose}" --service "${APP_NAME}" 2>"${_errf}")
        _rc=$?
    fi
    _err=$(cat "${_errf}" 2>/dev/null || true)
    if [ "${_errf}" != "/dev/null" ]; then
        rm -f "${_errf}"
    fi
    if [ "${_cleanup_tmp}" -eq 1 ]; then
        rm -f "${_tmp}"
    fi
    if [ "${_rc}" -ne 0 ]; then
        if [ -n "${_err}" ]; then
            out_die "sudoer-cli ${_verb} failed: ${_err}"
        fi
        out_die "sudoer-cli ${_verb} failed (exit ${_rc})"
    fi
    out_success "Submitted sudoer request via ${_cli} (${_verb})"
    if [ -n "${_out}" ] && [ "${JSON}" -eq 0 ]; then
        out_plain "${_out}"
    fi
    if [ "${JSON}" -eq 1 ]; then
