    if [ -z "${_out}" ]; then
        _out="${TMPDIR:-/tmp}/${APP_NAME}-$(key_current_login_user)-sudoers-admin.sh"
    fi
    _installed=$(key_default_installed_sudoers_path)
    _draft=$(key_default_project_sudoers_path)
