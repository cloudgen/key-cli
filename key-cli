# Backup a user's .ssh into KEY_CLI_ROOT before (or after) a mutate.
# create=1: mkdir .ssh when missing so a first auth-keys add still archives.
# create=0: no-op when .ssh is missing (restore of a new dest).
# Nested backup must not emit a second JSON object.
key_require_global_backup() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    local _subj _create _ssh _save_json _save_quiet
    _subj="${1:-}"
    _create="${2:-0}"
    if [ -z "${_subj}" ]; then
        out_die "Cannot take a global backup: missing username."
    fi
    _ssh=$(key_user_ssh_dir "${_subj}")
    if [ ! -d "${_ssh}" ]; then
        if [ "${_create}" -eq 1 ]; then
            mkdir -p "${_ssh}" || out_die "Cannot create ${_ssh} before global backup. Next: ${APP_NAME} backup ${_subj}."
            chmod 700 "${_ssh}" 2>/dev/null || true
        else
            unset _subj _create _ssh
            return 0
        fi
    fi
    _save_json="${JSON}"
    _save_quiet="${QUIET}"
    KEY_NESTED_BACKUP=1
    export KEY_NESTED_BACKUP
    if [ "${_save_json}" -eq 1 ]; then
        JSON=0
        QUIET=1
    fi
    key_cmd_backup "${_subj}"
    JSON="${_save_json}"
    QUIET="${_save_quiet}"
    KEY_NESTED_BACKUP=0
    export KEY_NESTED_BACKUP
    return 0
}

