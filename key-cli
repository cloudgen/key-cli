    fi
    return 0
}

# =============================================================================
# path_add_shell() - Main orchestrator: Add USER_BIN to shell PATHs
# =============================================================================
#
# GENERAL PURPOSE:
# Adds ${USER_BIN} (default ${HOME}/.local/bin) to bash, zsh, and fish
# configuration files if not already present. Creates BASHRC (default
# ~/.bashrc) when missing. Creates ~/.profile when missing so a login shell
# sources ~/.bashrc. Thin orchestrator for path_add_* / path_ensure_profile.
#
# Respects --json mode (silent in JSON).
#
# Last reviewed: 2026-09-09
# =============================================================================

path_add_shell() {
    local added=0
    local shell_config="N/A"
    : "${HOME:=/tmp}"
    : "${BASHRC:=${HOME}/.bashrc}"

    # Bash (create BASHRC if missing, then PATH)
    if path_add_bashrc; then
        added=1
        shell_config="${BASHRC}"
    fi

    # Zsh
    if path_add_zshrc; then
        added=1
        if [ "$shell_config" = "N/A" ]; then
            shell_config="${HOME}/.zshrc"
        else
            shell_config="${shell_config} ${HOME}/.zshrc"
        fi
    fi

    # Fish
    if path_add_fish; then
        added=1
        if [ "$shell_config" = "N/A" ]; then
            shell_config="${HOME}/.config/fish/config.fish"
        else
            shell_config="${shell_config} ${HOME}/.config/fish/config.fish"
        fi
    fi

    # Login rc: create ~/.profile if absent; never overwrite an existing body
    if path_ensure_profile; then
        added=1
        if [ "$shell_config" = "N/A" ]; then
            shell_config="${HOME}/.profile"
        fi
    fi

    if [ "$added" -eq 1 ] && [ "${JSON}" -eq 0 ]; then
        out_plain "→ Restart your terminal or run: source ${shell_config}"
    fi
}

# =============================================================================
# path_rc_test() - Type 0 test-purpose: PATH / profile ensure against --root
# =============================================================================
#
# GENERAL PURPOSE:
# Prove path-ensure / profile-ensure create|modify|noop on files under a
# caller --root tmp folder. Does not write this login's real ~/.bashrc.
# Law: requirement-shell-path-and-shell-support (rc-test).
#
# Last reviewed: 2026-09-09
# =============================================================================

path_rc_test() {
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${APP_NAME:=key-cli}"
    : "${VERSION:=0}"
    : "${JSON:=0}"
    local root="" file="bashrc" cas="create" created_root=0
    local real_bashrc="${HOME}/.bashrc"
    local real_profile="${HOME}/.profile"
    local dest="" before="" after="" path_line
    path_line=$(printf 'export PATH="%s:$PATH"' "${USER_BIN}")

    while [ $# -gt 0 ]; do
        case "$1" in
            --root)
                shift
                root="${1-}"
                ;;
            --file)
                shift
                file="${1-}"
                ;;
            --case)
                shift
                cas="${1-}"
                ;;
            --feature)
                shift
                ;;
            *)
                out_die "Unknown rc-test operand: $1. Next: ${APP_NAME} rc-test --root <dir> --file bashrc|profile|hook|symlink --case create|modify|noop|rewrite"
                ;;
        esac
        shift
    done

    case "${file}" in
        bashrc|zshrc|profile|hook|symlink) ;;
        *)
            out_die "Unknown rc-test --file ${file}. Next: use bashrc, zshrc, profile, hook, or symlink."
            ;;
    esac
    case "${cas}" in
        create|modify|noop|rewrite) ;;
        *)
            out_die "Unknown rc-test --case ${cas}. Next: use create, modify, noop, or rewrite."
            ;;
    esac

    if [ -z "${root}" ]; then
        root=$(mktemp -d "${TMPDIR:-/tmp}/rc-test.XXXXXX") || out_die "Could not create rc-test root."
        created_root=1
    fi
    if [ ! -d "${root}" ]; then
        mkdir -p "${root}" || out_die "Could not create rc-test --root ${root}."
    fi

    if [ "${file}" = "hook" ] || [ "${file}" = "symlink" ]; then
        if [ "${file}" = "symlink" ]; then
            mkdir -p "${root}/bin" || out_die "Could not create ${root}/bin."
            if [ "${cas}" = "create" ]; then
                rm -f "${root}/bin/${APP_NAME}" "${root}/bin/key-review-hook"
            fi
            : > "${root}/bin/${APP_NAME}"
            chmod 0755 "${root}/bin/${APP_NAME}" 2>/dev/null || true
            if [ "${cas}" = "noop" ] && [ ! -e "${root}/bin/key-review-hook" ]; then
                ln -s "${root}/bin/${APP_NAME}" "${root}/bin/key-review-hook"
            fi
            GLOBAL_BIN="${root}/bin"
            export GLOBAL_BIN
            key_ensure_login_hook_symlink
            if [ ! -L "${root}/bin/key-review-hook" ]; then
                out_die "rc-test ${cas} symlink did not create ${root}/bin/key-review-hook -> ${APP_NAME}."
            fi
            if [ -L "${root}/bin/${APP_NAME}" ]; then
                out_die "rc-test ${cas} reverse-symlinked ${APP_NAME}."
            fi
            if [ "${JSON}" -eq 1 ]; then
                out_json "out_success" "rc-test ${cas} symlink" "command" "rc-test" "file" "symlink" "case" "${cas}" "root" "${root}"
                return 0
            fi
            out_plain "→ rc-test ${cas} symlink under ${root}"
            return 0
        fi
        dest="${root}/.bashrc"
        if [ "${cas}" = "create" ]; then
            rm -f -- "${dest}"
        fi
        if [ "${cas}" = "rewrite" ]; then
            {
                printf '%s\n' "# BEGIN key-cli login hook"
                printf '%s\n' 'if ! sudo -n /usr/local/bin/key-cli auth-keys interactive; then'
                printf '%s\n' 'true'
                printf '%s\n' 'fi'
                printf '%s\n' "# END key-cli login hook"
            } > "${dest}"
        fi
        if [ "${cas}" = "noop" ]; then
            key_hook_block > "${dest}"
        fi
        before=$(cat "${dest}" 2>/dev/null || true)
        KEY_CLI_SETUP_HEAL=1
        export KEY_CLI_SETUP_HEAL
        HOME="${root}"
        export HOME
        key_heal_login_rc
        KEY_CLI_SETUP_HEAL=0
        export KEY_CLI_SETUP_HEAL
        after=$(cat "${dest}" 2>/dev/null || true)
        case "${after}" in
            *'/usr/local/bin/key-review-hook auth-keys interactive'*) ;;
            *)
                out_die "rc-test hook ${cas} missing key-review-hook doorbell."
                ;;
        esac
        if [ "${cas}" = "rewrite" ]; then
            case "${after}" in
                *'/usr/local/bin/key-cli auth-keys interactive'*)
                    out_die "rc-test hook rewrite left old key-cli doorbell."
                    ;;
            esac
        fi
        if [ "${cas}" = "noop" ] && [ "${before}" != "${after}" ]; then
            out_die "rc-test hook noop changed ${dest}."
        fi
        if [ -f "${real_bashrc}" ] && [ "${dest}" != "${real_bashrc}" ]; then
            :
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "out_success" "rc-test ${cas} hook" "command" "rc-test" "file" "hook" "case" "${cas}" "root" "${root}"
            return 0
        fi
        out_plain "→ rc-test ${cas} hook under ${root}"
        return 0
    fi

    case "${file}" in
        bashrc) dest="${root}/.bashrc"; export BASHRC="${dest}" ;;
        zshrc) dest="${root}/.zshrc"; export ZSHRC="${dest}" ;;
        profile) dest="${root}/.profile"; export PROFILE="${dest}" ;;
    esac

    case "${cas}" in
        create)
            rm -f -- "${dest}"
            ;;
        modify)
            printf '%s\n' "# dongle-keep-rc-test" > "${dest}"
            ;;
        noop)
            if [ "${file}" = "profile" ]; then
                {
                    printf '# BEGIN %s profile source-bashrc\n' "$APP_NAME"
                    printf 'if [ -n "${BASH_VERSION:-}" ]; then\n'
                    printf '    if [ -f "${HOME}/.bashrc" ]; then\n'
                    printf '        . "${HOME}/.bashrc"\n'
                    printf '    fi\n'
                    printf 'fi\n'
                    printf '# END %s profile source-bashrc\n' "$APP_NAME"
                } > "${dest}"
            else
                {
                    printf '# Interactive rc created by %s installer (%s)\n' "$APP_NAME" "$VERSION"
                    printf '# Added by %s installer (%s)\n' "$APP_NAME" "$VERSION"
                    printf '%s\n' "${path_line}"
                } > "${dest}"
            fi
            ;;
    esac

    before=$(cat "${dest}" 2>/dev/null || true)
    case "${file}" in
        bashrc) path_add_bashrc || true ;;
        zshrc)
            [ -f "${dest}" ] || : > "${dest}"
            path_add_zshrc || true
            ;;
        profile) path_ensure_profile || true ;;
    esac
    after=$(cat "${dest}" 2>/dev/null || true)

    if [ -f "${real_bashrc}" ] && [ "${dest}" != "${real_bashrc}" ]; then
        :
    fi
    if [ "${file}" = "bashrc" ] && [ -e "${real_bashrc}" ] && [ "${BASHRC}" != "${real_bashrc}" ]; then
        if [ "${cas}" = "create" ] && [ ! -f "${dest}" ]; then
            out_die "rc-test create did not write ${dest}."
        fi
    fi

    if [ "${file}" = "zshrc" ] && [ "${cas}" = "create" ]; then
        if [ -f "${dest}" ]; then
            out_die "rc-test create must not invent .zshrc."
        fi
        if [ "${JSON}" -eq 1 ]; then
            out_json "out_success" "rc-test create zshrc skipped (do not invent)" \
                "command" "rc-test" "file" "zshrc" "case" "create" "root" "${root}"
            return 0
        fi
        out_plain "→ rc-test create zshrc skipped (do not invent) under ${root}"
        return 0
    fi
    if [ "${cas}" = "create" ] && [ ! -f "${dest}" ]; then
        out_die "rc-test create did not create ${dest}. Next: check --root is writable."
    fi
    if [ "${cas}" = "modify" ]; then
        case "${after}" in
            *dongle-keep-rc-test*) ;;
            *)
                out_die "rc-test modify lost the dongle body in ${dest}."
                ;;
        esac
    fi
    if [ "${cas}" = "noop" ] && [ "${before}" != "${after}" ]; then
        out_die "rc-test noop changed ${dest}."
    fi
    if [ "${file}" != "profile" ]; then
        case "${after}" in
            *"${path_line}"*) ;;
            *)
                out_die "rc-test ${cas} missing exact PATH line in ${dest}."
                ;;
        esac
    else
        case "${after}" in
            *'. "${HOME}/.bashrc"'*) ;;
            *)
                out_die "rc-test ${cas} profile does not source bashrc."
                ;;
        esac
    fi

    if [ "${JSON}" -eq 1 ]; then
        out_json "out_success" "rc-test ${cas} ${file}" \
            "command" "rc-test" \
            "file" "${file}" \
            "case" "${cas}" \
            "root" "${root}"
        return 0
    fi
    out_plain "→ rc-test ${cas} ${file} under ${root}"
    if [ "${created_root}" -eq 1 ]; then
        out_plain "→ Created fixture root ${root} (caller may remove)"
    fi
    return 0
}

# =============================================================================
# util_sha256_file() - SHA-256 hex digest of a file (portable tool chain)
# =============================================================================
#
# GENERAL PURPOSE:
# Print the SHA-256 hex digest of file $1 to stdout for capture.
# Tries sha256sum (GNU/Linux) → shasum -a 256 (macOS) → openssl dgst.
# Return 1 if no tool or file unreadable.
#
# PRINTF/ECHO EXCEPTION (class B – return-via-stdout):
# Digests are data returns for $(util_sha256_file …), not product UI.
# =============================================================================

util_sha256_file() {
    local file="${1-}" dig=""
    if [ -z "${file}" ] || [ ! -f "${file}" ]; then
        return 1
    fi
    if command -v sha256sum >/dev/null 2>&1; then
        dig=$(sha256sum "${file}" 2>/dev/null | awk '{ print $1; exit }')
    elif command -v shasum >/dev/null 2>&1; then
        dig=$(shasum -a 256 "${file}" 2>/dev/null | awk '{ print $1; exit }')
    elif command -v openssl >/dev/null 2>&1; then
        # openssl dgst -sha256 → "SHA256(file)= hex" or "SHA2-256(file)= hex"
        dig=$(openssl dgst -sha256 "${file}" 2>/dev/null | awk '{ print $NF; exit }')
    else
        return 1
    fi
    if [ -z "${dig}" ]; then
        return 1
    fi
    printf '%s\n' "${dig}"
    return 0
}

# =============================================================================
# util_fetch_remote_version() - Extract VERSION="…" from remote SCRIPT_URL body
# =============================================================================
#
# GENERAL PURPOSE:
# Download SCRIPT_URL with curl or wget and print the remote VERSION value.
# Empty stdout on failure (caller fails loud). Class B return-via-stdout.
# =============================================================================

util_fetch_remote_version() {
    local url="${1-}"
    local body=""
    if [ -z "${url}" ]; then
        return 1
    fi
    if command -v curl >/dev/null 2>&1; then
        body=$(curl -fsSL "${url}" 2>/dev/null) || body=""
    elif command -v wget >/dev/null 2>&1; then
        body=$(wget -qO- "${url}" 2>/dev/null) || body=""
    else
        return 1
    fi
    if [ -z "${body}" ]; then
        return 1
    fi
    printf '%s\n' "${body}" | grep '^VERSION="' | head -n1 | cut -d'"' -f2
    return 0
}

# =============================================================================
# util_get_install_bin_path() - Return the correct binary path to operate on
# =============================================================================
#
# GENERAL PURPOSE:
# Returns the full path to the ${APP_NAME} binary that should be used for
# install/uninstall/update operations.
#
# Safe Variable Defaults
#
# Respects --force and --json.
# Respects root vs non-root isolation, --force-user, --force-global.
#
# For non-root: prefers ~/.local/bin, falls back to /usr/local/bin if present.
# For root: always uses /usr/local/bin.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is a minimal defensive helper to reduce repetition while preserving
# the strict root/non-root separation that has been battle-field tested.
#
# CRITICAL: Any change here must maintain zero cross-contamination between
# user and global installations.
#
# PRINTF EXCEPTION (class B – function return-via-stdout):
# Final printf '%s' "${bin_path}" is a data return for $(…) capture — not
# product UI. Warnings use out_warn. Callers must capture the path.
# See requirement-shell-output-requirements.md §2.1.1.
#
# Last reviewed: 2026-07-12
# =============================================================================

util_get_install_bin_path() {
    # --- Safe Variable Defaults ----
    # Defensive defaults - never assume globals are set
    # HOME before any ${HOME}/… path (INC-20260713-001 / set -u order)
    : "${APP_NAME:=app}"
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${FORCE_USER:=0}"
    : "${FORCE_GLOBAL:=0}"
    if [ -n "${PREFIX-}" ] && [ -d "${PREFIX}/bin" ]; then
    : "${GLOBAL_BIN:=${PREFIX}/bin}"
else
    : "${GLOBAL_BIN:=/usr/local/bin}"
fi
    : "${HOME:=/tmp}"
    : "${USER_BIN:=${HOME}/.local/bin}"

    local bin_path=""

    # Explicit force flags take precedence
    if [ "${FORCE_USER}" -eq 1 ]; then
        bin_path="${USER_BIN}/${APP_NAME}"
    elif [ "${FORCE_GLOBAL}" -eq 1 ] || [ "$(id -u)" -eq 0 ]; then
        bin_path="${GLOBAL_BIN}/${APP_NAME}"
    else
        # Normal non-root behavior: prefer user-local, fallback to global
        if [ -f "${USER_BIN}/${APP_NAME}" ]; then
            bin_path="${USER_BIN}/${APP_NAME}"
        elif [ -f "${GLOBAL_BIN}/${APP_NAME}" ]; then
            bin_path="${GLOBAL_BIN}/${APP_NAME}"
            if [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
                out_warn "Global installation found. Operating on it (you may need sudo for uninstall)."
            fi
        else
            bin_path="${USER_BIN}/${APP_NAME}"
        fi
    fi

    printf '%s' "${bin_path}"
}

# =============================================================================
# util_backup() - Create dated backup before any modification
# =============================================================================
#
# GENERAL PURPOSE:
# Creates a dated backup of a file or directory before destructive or
# modifying operations (rm -rf, sed, config changes).
#
# This implements CIAO Principle 10 (Right Backup & Restore Strategy).
#
# ────────────────────────────────────────────────
# CIAO PRINCIPLES APPLIED (v2.9.1)
# ────────────────────────────────────────────────
# Principle 1  (Caution)               - Safe path validation
# Principle 2  (Intentional Verbosity) - Full header + comments
# Principle 3  (Anti-fragile)          - Survives missing files gracefully
# Principle 7  (Reusable)              - Designed for reuse in other projects
# Principle 9  (Safe Temporary Files)  - Uses mktemp where needed
# Principle 10 (Backup Strategy)       - Dated backup with counter
#
# CRITICAL DEFENSIVE RULES:
# - Never modify files without creating backup first.
# - Refuse dangerous paths (/, $HOME, empty).
# - Backup name format: <name>.YYYYMMDD-N.bak
# - All messages go through out_text helpers only.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# This is the central backup mechanism. Any change must preserve dated backup
# naming and safety checks to prevent accidental data loss.
#
# Last reviewed: 29 April 2026
# =============================================================================

util_backup() {
    # --- Safe Variable Defaults ---
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    : "${PROJECT_NAME:=${APP_NAME}-demo}"
    : "${PROJECT_DIR:=${HOME}/${PROJECT_NAME}}"
    : "${JSON:=0}"
    : "${QUIET:=0}"

    local target="${1-}"
    local reason="${2:-pre-change}"

    if [ -z "$target" ]; then
        return 1
    fi

    # Safety check
    if [ "$target" = "/" ] || [ "$target" = "${HOME}" ] || [ -z "$target" ]; then
        out_warn "Refusing to backup dangerous path: $target"
        return 1
    fi

    local timestamp
    timestamp=$(date +%Y%m%d)
    local counter=1
    local backup_path

    if [ -d "$target" ]; then
        backup_path="${target}.${timestamp}-${counter}.bak"
        while [ -e "$backup_path" ]; do
            counter=$((counter + 1))
            backup_path="${target}.${timestamp}-${counter}.bak"
        done
        cp -a "$target" "$backup_path" 2>/dev/null && \
            out_info "Backup created: $backup_path (reason: $reason)" || \
            out_warn "Failed to create backup of directory $target"
    elif [ -f "$target" ]; then
        backup_path="${target}.${timestamp}-${counter}.bak"
        while [ -e "$backup_path" ]; do
            counter=$((counter + 1))
            backup_path="${target}.${timestamp}-${counter}.bak"
        done
        cp "$target" "$backup_path" 2>/dev/null && \
            out_info "Backup created: $backup_path (reason: $reason)" || \
            out_warn "Failed to create backup of file $target"
    fi
}

# =============================================================================
# util_try_mkdir_storage() - Fail-soft mkdir probe for one storage root
# =============================================================================
#
# GENERAL PURPOSE:
# mkdir -p a candidate scratch/cache root, then re-test that it exists and is
# writable. Used only by util_resolve_storage. A failed mkdir MUST NOT abort
# the CLI — the resolver walks the next tier.
#
# ALIGNMENT (live requirements only):
# - requirement-shell-cli-storage.md
#
# Last updated: 2026-09-11
# =============================================================================
util_try_mkdir_storage() {
    _try_dir="${1:-}"
    if [ -z "${_try_dir}" ]; then
        unset _try_dir
        return 1
    fi
    mkdir -p "${_try_dir}" 2>/dev/null || true
    if [ -d "${_try_dir}" ] && [ -w "${_try_dir}" ]; then
        unset _try_dir
        return 0
    fi
    unset _try_dir
    return 1
}

# =============================================================================
# util_resolve_storage() - Storage resolver
# =============================================================================
#
# GENERAL PURPOSE:
# Returns the best available volatile storage directory for prompt files.
# Walks a documented chain. mkdir of each leaf is fail-soft (re-test -d/-w).
# Isolation leaf is ${APP_NAME}-${USERNAME} under the chosen cache root.
#
# Live chain (requirement-shell-cli-storage):
#   1. /dev/shm/${APP_NAME}-${USERNAME}
#   2a. Termux: ${PREFIX}/tmp/${APP_NAME}-${USERNAME}
#   2b. Git Bash: $HOME/AppData/Local/Temp/cache/… else /c/Users/${USERNAME}/…
#   3. $TEMP/cache/${APP_NAME}-${USERNAME}
#   4. /tmp/cache/… else /tmp/${APP_NAME}-${USERNAME}
#   5. STORAGE_DIR (XDG cache fallback)
# Die only at the END if no root worked. Do not warn when leaving /dev/shm.
#
# CIAO PRINCIPLES APPLIED:
# - Caution: Must work correctly when the same computer is used by multiple
#   different users (normal user, sudo, root, shared servers, containers).
# - Intentionality: Never allow one user's files to be readable/writable by
#   another user. Every directory creation must be ownership-aware.
# - Anti-fragile: Survive permission conflicts, Git Bash fake /dev/shm, and
#   multi-user environments. mkdir fail-soft; next root.
#
# CRITICAL WARNING - MULTI-USER PROBLEM AI FREQUENTLY OVERLOOKS:
# Many good applications on a computer are run by different users over time
# (e.g. normal user → sudo → another login account).
#
# AI assistants often simply "add mkdir -p" when solving a storage task without
# considering ownership and cross-user write privilege. This approach is
# untested and problematic — it can create directories owned by one user that
# another user cannot read/write, or allow unintended access between users.
#
# That is why we intentionally isolate folders per user (${APP_NAME}-${USERNAME})
# and why any change to this function must preserve strict per-user isolation.
# Rewriting this with a generic shared folder is forbidden and has caused
# permission bugs in the past.
#
# !!! DO NOT MODIFY OR SIMPLIFY THIS FUNCTION !!!
# Designed to be reusable in other projects.
#
# ECHO EXCEPTION (class B – function return-via-stdout):
# echo of storage paths is a data return for $(util_resolve_storage) capture,
# not a product user message. Failures use out_die only after the full chain.
# See requirement-shell-output-requirements.md §2.1.1.
#
# Lessons Learned (CIAO Reflection):
# 2026-07-13: STORAGE_DIR was bare/unset on third fallback (INC-20260713-001 P1).
# 2026-07-14: Third fallback uses XDG_CACHE_HOME / HOME/.cache / /tmp with
#             per-user ${APP_NAME}-${USERNAME} isolation under set -u.
# 2026-07-16: Create chosen tier root before echo (fail-closed) for all tiers;
#             wire from app_main (EFFECTIVE_STORAGE_DIR + TMPDIR). SM-STOR-01.
# 2026-09-11: Git Bash /dev/shm can look writable then mkdir fails; dying on
#             that one leaf printed [ERROR] and skipped AppData Local Temp.
#             mkdir is a probe (INC-20260911-001).
#
# Last updated: 2026-09-11
# SSOT: requirement-shell-cli-storage.md
# =============================================================================
util_resolve_storage() {
    # --- Safe Variable Defaults ----
    # Defensive defaults - never assume globals are set
    : "${USERNAME:=unknown}"
    : "${APP_NAME:=app}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${PREFIX:=}"
    : "${TEMP:=}"

    _leaf="${APP_NAME}-${USERNAME}"
    _storage_candidate=""

    # 1. RAM disk isolated child (fail-soft — Git Bash /dev/shm is often fake)
    if [ -z "${_storage_candidate}" ] && [ -d "/dev/shm" ]; then
        if util_try_mkdir_storage "/dev/shm/${_leaf}"; then
            _storage_candidate="/dev/shm/${_leaf}"
        fi
    fi

    # 2a. Termux this-login prefix tmp
    if [ -z "${_storage_candidate}" ]; then
        if key_is_termux; then
            if util_try_mkdir_storage "${PREFIX}/tmp/${_leaf}"; then
                _storage_candidate="${PREFIX}/tmp/${_leaf}"
            fi
        fi
    fi

    # 2b. Git Bash Windows user temp (parent must already exist)
    if [ -z "${_storage_candidate}" ]; then
        if key_is_git_bash; then
            _gb_parent=""
            if [ -d "${HOME}/AppData/Local/Temp" ]; then
                _gb_parent="${HOME}/AppData/Local/Temp"
            elif [ -d "/c/Users/${USERNAME}/AppData/Local/Temp" ]; then
                _gb_parent="/c/Users/${USERNAME}/AppData/Local/Temp"
            fi
            if [ -n "${_gb_parent}" ]; then
                if util_try_mkdir_storage "${_gb_parent}/cache/${_leaf}"; then
                    _storage_candidate="${_gb_parent}/cache/${_leaf}"
                fi
            fi
            unset _gb_parent
        fi
    fi

    # 3. $TEMP/cache
    if [ -z "${_storage_candidate}" ] && [ -n "${TEMP}" ] && [ -d "${TEMP}" ]; then
        if util_try_mkdir_storage "${TEMP}/cache/${_leaf}"; then
            _storage_candidate="${TEMP}/cache/${_leaf}"
        fi
    fi

    # 4. /tmp/cache else /tmp isolated child
    if [ -z "${_storage_candidate}" ] && [ -d "/tmp" ]; then
        if util_try_mkdir_storage "/tmp/cache/${_leaf}"; then
            _storage_candidate="/tmp/cache/${_leaf}"
        elif util_try_mkdir_storage "/tmp/${_leaf}"; then
            _storage_candidate="/tmp/${_leaf}"
        fi
    fi

    # 5. Config / XDG cache (not the Git Bash volatile root when AppData exists)
    if [ -z "${_storage_candidate}" ]; then
        : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${_leaf}}"
        if util_try_mkdir_storage "${STORAGE_DIR}"; then
            _storage_candidate="${STORAGE_DIR}"
        fi
    fi

    if [ -z "${_storage_candidate}" ]; then
        out_die "Cannot create a writable storage folder for ${APP_NAME}. Next: set STORAGE_DIR to a writable folder and retry."
    fi
    echo "${_storage_candidate}"
    unset _storage_candidate _leaf
    return 0
}

# =============================================================================
# util_resolve_persistent_storage() - Durable this-login folder (not /dev/shm)
# =============================================================================
#
# GENERAL PURPOSE:
# preferred-remote, download-folders, and other leaves that must survive
# reboot live under ${HOME}/.local/${APP_NAME}, not the volatile cache chain.
#
# ALIGNMENT: requirement-shell-config-backup.md · requirement-shell-cli-storage.md
