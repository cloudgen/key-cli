# Login-hook doorbell: /usr/local/bin/key-review-hook -> key-cli
# Law: requirement-login-interactive-review-hook.md
key_review_hook_name() {
    : "${KEY_REVIEW_HOOK_NAME:=key-review-hook}"
    printf '%s' "${KEY_REVIEW_HOOK_NAME}"
}

key_hook_block() {
    : "${APP_NAME:=key-cli}"
    : "${KEY_ADM_USER:=key-adm}"
    cat <<'EOF'
# BEGIN key-cli login hook
if [ -z "${KEY_CLI_LOGIN_HOOK_RAN:-}" ] \
    && [ -n "${PS1:-}" ] \
    && [ -t 0 ] && [ -t 1 ] \
    && case "$-" in *i*) true ;; *) false ;; esac \
    && [ "$(id -un)" = "key-adm" ] \
    && [ -z "${SSH_ORIGINAL_COMMAND:-}" ]; then
    KEY_CLI_LOGIN_HOOK_RAN=1
    export KEY_CLI_LOGIN_HOOK_RAN
    if ! sudo -n /usr/local/bin/key-review-hook auth-keys interactive; then
        printf '%s\n' "key-cli: login review hook skipped (sudo -n failed)" >&2
    fi
fi
# END key-cli login hook
EOF
}

key_profile_source_block() {
    : "${APP_NAME:=key-cli}"
    cat <<'EOF'
# BEGIN key-cli profile source-bashrc
# Created so a bash login shell sources interactive rc (hook lives in .bashrc).
if [ -n "${BASH_VERSION:-}" ]; then
    if [ -f "${HOME}/.bashrc" ]; then
        . "${HOME}/.bashrc"
    fi
fi
# END key-cli profile source-bashrc
EOF
}

util_align_rc_owner() {
    local _file _user
    _file="${1-}"
    _user="${2-}"
    if [ -z "${_file}" ] || [ ! -f "${_file}" ]; then
        unset _file _user
        return 0
    fi
    chmod 0644 "${_file}" 2>/dev/null || true
    if [ -n "${_user}" ] && id "${_user}" >/dev/null 2>&1; then
        if [ "$(id -u 2>/dev/null || echo 1)" -eq 0 ] || [ "$(id -un 2>/dev/null || echo "")" = "${_user}" ]; then
            chown "${_user}" "${_file}" || out_die "Cannot chown ${_file} to ${_user}."
        fi
    fi
    unset _file _user
    return 0
}

key_ensure_login_hook_symlink() {
    : "${APP_NAME:=key-cli}"
    : "${GLOBAL_BIN:=/usr/local/bin}"
    : "${KEY_REVIEW_HOOK_NAME:=key-review-hook}"
    : "${KEY_CLI_TEST_HEAL_RC:=0}"
    local _bin _hook
    if key_is_normal_user_only_cli; then
        return 0
    fi
    if [ "${GLOBAL_BIN}" = "/usr/local/bin" ] && [ "${KEY_CLI_TEST_HEAL_RC}" = "1" ]; then
        return 0
    fi
    _bin="${GLOBAL_BIN}/${APP_NAME}"
    _hook="${GLOBAL_BIN}/${KEY_REVIEW_HOOK_NAME}"
    if [ ! -e "${_bin}" ]; then
        unset _bin _hook
        return 0
    fi
    if [ -L "${_bin}" ]; then
        unset _bin _hook
        return 0
    fi
    if [ -e "${_hook}" ]; then
        unset _bin _hook
        return 0
    fi
    ln -s "${_bin}" "${_hook}" || true
    unset _bin _hook
    return 0
}

key_rewrite_old_hook_lines() {
    local _file _tmp
    _file="${1-}"
    if [ -z "${_file}" ] || [ ! -f "${_file}" ]; then
        unset _file
        return 0
    fi
    if ! grep -q 'BEGIN key-cli login hook' "${_file}" 2>/dev/null; then
        unset _file
        return 0
    fi
    if grep -q '/usr/local/bin/key-review-hook auth-keys interactive' "${_file}" 2>/dev/null \
        && ! grep -q '/usr/local/bin/key-cli auth-keys interactive' "${_file}" 2>/dev/null \
        && ! grep -q '/usr/local/bin/key-cli-hook ' "${_file}" 2>/dev/null; then
        unset _file
        return 0
    fi
    _tmp=$(mktemp "${_file}.XXXXXX") || return 1
    sed \
        -e 's|/usr/local/bin/key-cli auth-keys interactive|/usr/local/bin/key-review-hook auth-keys interactive|g' \
        -e 's|/usr/local/bin/key-cli-hook |/usr/local/bin/key-review-hook |g' \
        "${_file}" > "${_tmp}" || { rm -f "${_tmp}"; return 1; }
    mv "${_tmp}" "${_file}" || { rm -f "${_tmp}"; return 1; }
    unset _file _tmp
    return 0
}

key_heal_login_rc() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${TTY:=0}"
    : "${HOME:=/tmp}"
    : "${KEY_ADM_USER:=key-adm}"
    : "${KEY_CLI_TEST_HEAL_RC:=0}"
    : "${KEY_CLI_SETUP_HEAL:=0}"
    local _who _bashrc _profile _tmp _owner
    if key_is_normal_user_only_cli; then
        return 0
    fi
    if [ "${JSON}" -eq 1 ] && [ "${KEY_CLI_SETUP_HEAL}" != "1" ]; then
        return 0
    fi
    if [ "${KEY_CLI_SETUP_HEAL}" != "1" ]; then
        if [ "${TTY}" -ne 1 ] && [ "${KEY_CLI_TEST_HEAL_RC}" != "1" ]; then
            return 0
        fi
        _who=$(id -un 2>/dev/null || echo "")
        if [ "${_who}" != "${KEY_ADM_USER}" ]; then
            unset _who
            return 0
        fi
        case "${HOME}" in
            ""|/tmp|/tmp/*|/dev/shm|/dev/shm/*)
                unset _who
                return 0
                ;;
        esac
    fi
    _bashrc="${HOME}/.bashrc"
    _profile="${HOME}/.profile"
    _owner="${KEY_ADM_USER}"
    if [ ! -f "${_bashrc}" ]; then
        : > "${_bashrc}" || return 0
    fi
    if ! grep -q 'BEGIN key-cli login hook' "${_bashrc}" 2>/dev/null; then
        _tmp=$(mktemp "${_bashrc}.${APP_NAME}.XXXXXX") || return 1
        cat "${_bashrc}" > "${_tmp}" || { rm -f "${_tmp}"; return 1; }
        printf '\n' >> "${_tmp}"
        key_hook_block >> "${_tmp}" || { rm -f "${_tmp}"; return 1; }
        mv "${_tmp}" "${_bashrc}" || { rm -f "${_tmp}"; return 1; }
    else
        key_rewrite_old_hook_lines "${_bashrc}"
    fi
    util_align_rc_owner "${_bashrc}" "${_owner}"
    if [ ! -f "${_profile}" ]; then
        key_profile_source_block > "${_profile}" || return 1
        util_align_rc_owner "${_profile}" "${_owner}"
    fi
    unset _who _bashrc _profile _tmp _owner
    return 0
}

key_review_approver_login_rc() {
    : "${KEY_ADM_HOME:=/etc/key-adm}"
    : "${KEY_ADM_USER:=key-adm}"
    local _bashrc
    _bashrc="${KEY_ADM_HOME}/.bashrc"
    if [ ! -f "${_bashrc}" ] || [ ! -w "${_bashrc}" ]; then
        unset _bashrc
        return 0
    fi
    key_rewrite_old_hook_lines "${_bashrc}"
    util_align_rc_owner "${_bashrc}" "${KEY_ADM_USER}"
    unset _bashrc
    return 0
}

key_cmd_setup() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${KEY_ADM_USER:=key-adm}"
    : "${KEY_ADM_UID:=1666}"
    : "${KEY_ADM_GID:=1666}"
    : "${KEY_ADM_HOME:=/etc/key-adm}"
    : "${KEY_ADM_SHELL:=/bin/bash}"
    if key_is_normal_user_only_cli; then
        out_die "setup is not available for $(key_host_normal_user_only_label). Next: use a POSIX Linux host as root."
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        out_die "Creating ${KEY_ADM_USER} needs a root login. Next: sudo ${APP_NAME} setup (or a root login)."
    fi
    if ! command -v useradd >/dev/null 2>&1; then
        out_die "useradd not found. Next: install passwd/shadow-utils, then ${APP_NAME} setup."
    fi
    if id "${KEY_ADM_USER}" >/dev/null 2>&1; then
        out_info "Account ${KEY_ADM_USER} already exists."
    else
        if command -v getent >/dev/null 2>&1; then
            if getent passwd "${KEY_ADM_UID}" >/dev/null 2>&1; then
                out_die "UID ${KEY_ADM_UID} is already in use. Next: free that UID or set KEY_ADM_UID."
            fi
            if getent group "${KEY_ADM_GID}" >/dev/null 2>&1; then
                out_die "GID ${KEY_ADM_GID} is already in use. Next: free that GID or set KEY_ADM_GID."
            fi
        fi
        if command -v groupadd >/dev/null 2>&1; then
            groupadd -g "${KEY_ADM_GID}" "${KEY_ADM_USER}" || out_die "groupadd ${KEY_ADM_USER} failed."
        fi
        useradd -u "${KEY_ADM_UID}" -g "${KEY_ADM_GID}" -d "${KEY_ADM_HOME}" -s "${KEY_ADM_SHELL}" -m "${KEY_ADM_USER}" \
            || out_die "useradd ${KEY_ADM_USER} failed."
        out_success "Created ${KEY_ADM_USER} (UID ${KEY_ADM_UID}, home ${KEY_ADM_HOME})."
    fi
    mkdir -p "${KEY_ADM_HOME}" || out_die "Cannot create ${KEY_ADM_HOME}."
    chown "${KEY_ADM_USER}:${KEY_ADM_USER}" "${KEY_ADM_HOME}" 2>/dev/null || true
    chmod 0750 "${KEY_ADM_HOME}" 2>/dev/null || true
    _root=$(key_cli_root)
    mkdir -p "${_root}" || out_die "Cannot create ${_root}."
    chown root:root "${_root}" 2>/dev/null || true
    chmod 0755 "${_root}" 2>/dev/null || true
    mkdir -p "${_root}/auth-key-request" "${_root}/auth-key-accepted" "${_root}/auth-key-declined" \
        || out_die "Cannot create auth-key queue directories under ${_root}."
    chown root:root "${_root}/auth-key-request" "${_root}/auth-key-accepted" "${_root}/auth-key-declined" 2>/dev/null || true
    chmod 1733 "${_root}/auth-key-request" 2>/dev/null || true
    chmod 0751 "${_root}/auth-key-accepted" "${_root}/auth-key-declined" 2>/dev/null || true
    key_ensure_login_hook_symlink
    _save_home="${HOME}"
    KEY_CLI_SETUP_HEAL=1
    export KEY_CLI_SETUP_HEAL
    HOME="${KEY_ADM_HOME}"
    export HOME
    key_heal_login_rc
    HOME="${_save_home}"
    export HOME
    KEY_CLI_SETUP_HEAL=0
    export KEY_CLI_SETUP_HEAL
    unset _save_home
    _f6=$(key_lpu_sudoers_path)
    _f6dir=$(dirname -- "${_f6}")
    mkdir -p "${_f6dir}" || out_die "Cannot create ${_f6dir}."
    _tmp=$(mktemp -t "${APP_NAME}.lpu-sudoers.XXXXXX") || out_die "Could not stage F6 sudoers."
    key_lpu_sudoers_fragment_text >"${_tmp}" || out_die "Cannot write F6 draft."
    if command -v visudo >/dev/null 2>&1; then
        visudo -c -f "${_tmp}" || { rm -f "${_tmp}"; out_die "visudo -c failed for ${_f6} draft."; }
    fi
    install -m 0440 -o root -g root "${_tmp}" "${_f6}" || { rm -f "${_tmp}"; out_die "Cannot install ${_f6}."; }
    rm -f "${_tmp}"
    _inc="$(key_sudoers_d_dir)/${KEY_ADM_USER}"
    _incdir=$(dirname -- "${_inc}")
    if [ -d "${_incdir}" ]; then
        printf '#include %s\n' "${_f6}" > "${_inc}.tmp" || out_die "Cannot write include drop-in."
        if command -v visudo >/dev/null 2>&1; then
            visudo -c -f "${_inc}.tmp" || { rm -f "${_inc}.tmp"; out_die "visudo -c failed for ${_inc}."; }
        fi
        install -m 0440 -o root -g root "${_inc}.tmp" "${_inc}" || { rm -f "${_inc}.tmp"; out_die "Cannot install ${_inc}."; }
        rm -f "${_inc}.tmp"
        out_info "Installed include ${_inc} → ${_f6}"
    else
        out_warn "No ${_incdir}; F6 is at ${_f6}. Next: add #include ${_f6} to sudoers as root."
    fi
    out_success "setup complete: ${KEY_ADM_USER} can sudo ${APP_NAME} backup/restore/auth-keys add and review auth-key requests on behalf of other users."
    if [ "${JSON}" -eq 1 ]; then
        out_json "setup" "ok" \
            "lpu" "${KEY_ADM_USER}" \
            "uid" "${KEY_ADM_UID}" \
            "home" "${KEY_ADM_HOME}" \
            "sudoers" "${_f6}"
    fi
    unset _root _f6 _f6dir _tmp _inc _incdir
    return 0
}

key_cmd_remove_lpu() {
    : "${APP_NAME:=key-cli}"
    : "${JSON:=0}"
    : "${FORCE:=0}"
    : "${KEY_ADM_USER:=key-adm}"
    if key_is_normal_user_only_cli; then
        out_die "remove-lpu is not available for $(key_host_normal_user_only_label). Next: use a POSIX Linux host as root."
    fi
    if [ "$(id -u 2>/dev/null || echo 1)" -ne 0 ]; then
        out_die "Removing ${KEY_ADM_USER} needs a root login. Next: sudo ${APP_NAME} remove-lpu --force (or a root login)."
    fi
    if [ "${FORCE}" -ne 1 ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ]; then
            if ! prompt_yes_no "Remove least-privilege user ${KEY_ADM_USER}?"; then
                out_info "remove-lpu cancelled."
                return 0
            fi
        else
            out_die "remove-lpu needs --force when not on a TTY."
        fi
    fi
    _f6=$(key_lpu_sudoers_path)
    _inc="$(key_sudoers_d_dir)/${KEY_ADM_USER}"
    _bak_root=$(key_cli_root)/lpu-remove
    mkdir -p "${_bak_root}" 2>/dev/null || true
    _day=$(date +%Y%m%d)
    if [ -f "${_f6}" ]; then
        cp "${_f6}" "${_bak_root}/sudoers-${KEY_ADM_USER}-${_day}.bak" 2>/dev/null || true
        rm -f "${_f6}"
    fi
    if [ -f "${_inc}" ]; then
        rm -f "${_inc}"
    fi
    if id "${KEY_ADM_USER}" >/dev/null 2>&1; then
        userdel -r "${KEY_ADM_USER}" || out_die "userdel -r ${KEY_ADM_USER} failed."
    fi
    if command -v groupdel >/dev/null 2>&1; then
        groupdel "${KEY_ADM_USER}" 2>/dev/null || true
    fi
    out_success "Removed ${KEY_ADM_USER}. Archives under $(key_cli_root) were kept."
    if [ "${JSON}" -eq 1 ]; then
        out_json "remove-lpu" "ok" "lpu" "${KEY_ADM_USER}"
    fi
    unset _f6 _inc _bak_root _day
    return 0
}

