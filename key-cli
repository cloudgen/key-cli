key_is_termux() {
    : "${PREFIX:=}"
    if [ -n "${PREFIX}" ] && [ -d "${PREFIX}/bin" ]; then
        case "${PREFIX}" in
            */com.termux/*) return 0 ;;
        esac
    fi
    if [ -n "${TERMUX_VERSION-}" ] || [ -d /data/data/com.termux/files/usr ]; then
        return 0
    fi
    return 1
}

# =============================================================================
# key_is_git_bash() / key_is_windows_cmd() / key_is_normal_user_only_cli()
# =============================================================================
#
# GENERAL PURPOSE:
# Termux, Git Bash (Git for Windows MSYS/MINGW), and Windows cmd (Command
# Prompt / Windows command-line) are a command line for normal user only:
# Type 1 (admin privilege) and Type 2 (dedicated system user privilege)
# stay unused. Union helper covers all three instances.
#
# ALIGNMENT (live requirements only):
# - requirement-shell-cli-interface.md
# - requirement-shell-termux-ish.md
#
# Last updated: 2026-09-05
# =============================================================================

key_is_git_bash() {
    case "${MSYSTEM-}" in
        MINGW*|MSYS*|UCRT*|CLANG*) return 0 ;;
    esac
    _uname=$(uname -s 2>/dev/null || true)
    case "${_uname}" in
        MINGW*|MSYS*) return 0 ;;
    esac
    return 1
}

key_is_windows_cmd() {
    if key_is_git_bash; then
        return 1
    fi
    if [ -n "${WSL_DISTRO_NAME-}" ]; then
        return 1
    fi
    _uname=$(uname -s 2>/dev/null || true)
    case "${_uname}" in
        CYGWIN*) return 1 ;;
    esac
    case "${OS-}" in
        Windows_NT) return 0 ;;
    esac
    case "${ComSpec-}${COMSPEC-}" in
        *[Cc][Mm][Dd].[Ee][Xx][Ee]*) return 0 ;;
    esac
    case "${_uname}" in
        Linux) return 1 ;;
    esac
    return 1
}

key_is_normal_user_only_cli() {
    if key_is_termux; then
        return 0
    fi
    if key_is_git_bash; then
        return 0
    fi
    if key_is_windows_cmd; then
        return 0
    fi
    return 1
}

# Host OS display name for operator copy (not a platform class).
# /etc/os-release NAME= first; else uname -s; else Linux.
key_os_name() {
    _name=""
    if [ -r /etc/os-release ]; then
        _name=$(grep -E '^NAME=' /etc/os-release 2>/dev/null | head -n 1 || true)
        _name=${_name#NAME=}
        _name=${_name#\"}
        _name=${_name%\"}
        _name=${_name#\'}
        _name=${_name%\'}
    fi
    if [ -z "${_name}" ]; then
        _name=$(uname -s 2>/dev/null || true)
    fi
    if [ -z "${_name}" ]; then
        _name="Linux"
    fi
    printf '%s' "${_name}"
    unset _name
}

