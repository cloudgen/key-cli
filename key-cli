        return 0
    fi
    if ! key_valid_username "${_asked}"; then
        out_die "Invalid username '${_asked}'. Use a login name with letters, digits, dot, underscore, or hyphen."
    fi
    if [ "${_asked}" != "${_self}" ] && ! key_can_on_behalf; then
        out_die "Cannot act on behalf of '${_asked}'. Next: run as $(key_adm_user), or omit the username to use this login (${_self})."
    fi
    printf '%s' "${_asked}"
    unset _asked _self
}

