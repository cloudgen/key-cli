        fi
        case "${_choice}" in
            21|backup)
                out_msg_n "username to backup: "
                _u=""
                read -r _u || true
                if [ -n "${_u}" ]; then
                    key_cmd_backup "${_u}"
                fi
                unset _u
                continue
                ;;
            22|restore)
                out_msg_n "username to restore: "
                _u=""
                read -r _u || true
                if [ -n "${_u}" ]; then
                    key_cmd_restore "${_u}"
                fi
                unset _u
                continue
                ;;
            23|auth-keys)
                out_msg_n "username for authorized_keys: "
                _u=""
                read -r _u || true
                out_msg_n "public-key file: "
                _f=""
                read -r _f || true
                if [ -n "${_u}" ] && [ -n "${_f}" ]; then
                    key_cmd_auth_keys add "${_u}" "${_f}"
                fi
                unset _u _f
                continue
                ;;
            24|pending)
                key_cmd_auth_keys pending
                continue
                ;;
            25|interactive)
                key_cmd_auth_keys interactive
                continue
                ;;
            0|q|"")
                unset _choice
                return 0
                ;;
            *)
                if key_menu_typed_leaf; then
                    continue
                fi
                out_warn "Unknown menu choice '${_choice}'. Choose a number from the list, or type the command name."
                continue
                ;;
        esac
    done
}

key_cmd_menu_self() {
    while true; do
        out_info "**${APP_NAME}**(*${VERSION}*) — self-management"
        out_menu_choice "81" "install" "place ${APP_NAME}; ensure rc PATH"
        out_menu_choice "82" "version" "show version and detailed diagnostics (about)"
        out_menu_choice "83" "about" "show detailed diagnostics"
        out_menu_choice "84" "version-check" "compare local vs remote version"
        out_menu_choice "85" "self-update" "update ${APP_NAME} to a newer remote version"
        out_menu_choice "86" "self-uninstall" "remove ${APP_NAME} (safe PATH cleanup)"
        out_plain "0. Back"
        out_msg_n "Choose a number, or type the command name: "
        _choice=""
        if ! read -r _choice; then
            unset _choice
            return 0
        fi
        case "${_choice}" in
            81|install) inst_perform_install; continue ;;
            82|version) app_about; continue ;;
            83|about) app_about; continue ;;
            84|version-check) ver_check; continue ;;
            85|self-update) inst_self_update; continue ;;
            86|self-uninstall) inst_self_uninstall; continue ;;
            0|q|"")
                unset _choice
                return 0
                ;;
            *)
                if key_menu_typed_leaf; then
                    continue
                fi
                out_warn "Unknown menu choice '${_choice}'. Choose a number from the list, or type the command name."
                continue
                ;;
        esac
    done
}

key_cmd_menu() {
    if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ] || [ "${TTY}" -ne 1 ]; then
        out_die "menu needs a terminal. Run a named command instead, for example: ${APP_NAME} backup"
    fi
    while true; do
        out_info "**${APP_NAME}**(*${VERSION}*)"
        out_menu_choice "1" "keys" "this login ~/.ssh backup, restore, authorized_keys"
        if key_menu_show_on_behalf; then
            out_menu_choice "2" "on-behalf" "as key-adm: backup/restore/auth-keys for other users"
        elif ! key_is_normal_user_only_cli; then
            out_info "on-behalf features are not available except as $(key_adm_user)"
        fi
        out_menu_choice "8" "self-management" "this CLI install, version, update, uninstall"
        out_plain "9. Exit"
        out_msg_n "Choose a number, or type the command name: "
        _choice=""
        if ! read -r _choice; then
            unset _choice
            return 0
        fi
        case "${_choice}" in
            1|keys) key_cmd_menu_keys; continue ;;
            2|on-behalf)
                if key_menu_show_on_behalf; then
                    key_cmd_menu_on_behalf
                    continue
                fi
                out_warn "Unknown menu choice '${_choice}'. Choose a number from the list, or type the command name."
                continue
                ;;
            8|self-management) key_cmd_menu_self; continue ;;
            9|exit|q|"")
                unset _choice
                return 0
                ;;
            *)
                if key_menu_typed_leaf; then
                    continue
                fi
                out_warn "Unknown menu choice '${_choice}'. Choose a number from the list, or type the command name."
                continue
                ;;
        esac
    done
}

app_about() {
    : "${JSON:=0}"
    : "${QUIET:=0}"
    : "${APP_NAME:=key-cli}"
    : "${VERSION:=2.0.3}"
    if [ -n "${PREFIX-}" ] && [ -d "${PREFIX}/bin" ]; then
        : "${GLOBAL_BIN:=${PREFIX}/bin}"
    else
        : "${GLOBAL_BIN:=/usr/local/bin}"
    fi
    : "${USER_BIN:=${HOME}/.local/bin}"
    : "${SCRIPT_URL:=}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    if [ -z "${EFFECTIVE_STORAGE_DIR:-}" ]; then
        EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    fi
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    _root=$(key_cli_root)
    _adm=$(key_adm_user)
    _adm_present="false"
    if id "${_adm}" >/dev/null 2>&1; then
        _adm_present="true"
    fi
    if [ "${JSON}" -eq 1 ]; then
        local installed="false"
        inst_is_installed && installed="true"
        local global_ver="not found"
        if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
            global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi
        local local_ver="not found"
        if [ -x "${USER_BIN}/${APP_NAME}" ]; then
            local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        fi
        local current_shell
        current_shell=$(util_get_current_shell)
        local interactive="false"
        [ -t 1 ] && interactive="true"
        local current_user
        current_user="$(id -un 2>/dev/null || echo "unknown")"
        out_json "about" "" \
            "app" "${APP_NAME}" \
            "version" "${VERSION}" \
            "installed" "${installed}" \
            "global_version" "${global_ver}" \
            "local_version" "${local_ver}" \
            "shell" "${current_shell}" \
            "interactive" "${interactive}" \
            "user" "${current_user}" \
            "effective_storage" "${EFFECTIVE_STORAGE_DIR}" \
            "storage_dir" "${STORAGE_DIR}" \
            "key_cli_root" "${_root}" \
            "key_adm" "${_adm}" \
            "key_adm_present" "${_adm_present}"
        unset _root _adm _adm_present
        return 0
    fi
    [ "${QUIET}" -eq 1 ] && return 0
    out_info "=== ${APP_NAME} ${VERSION} - About / Diagnostics ==="
    out_empty_line
    if inst_is_installed; then
        out_success "${APP_NAME} is properly installed."
    else
        out_warn "${APP_NAME} is NOT installed in your PATH."
        if [ -n "${SCRIPT_URL}" ]; then
            out_info "   Recommended: curl -fsSL ${SCRIPT_URL} | sh"
        else
            out_info "   Set SCRIPT_URL to the install script URL, then: curl -fsSL \"\${SCRIPT_URL}\" | sh"
        fi
    fi
    out_empty_line
    if [ -x "${GLOBAL_BIN}/${APP_NAME}" ]; then
        global_ver=$(grep '^VERSION="' "${GLOBAL_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   ${global_ver}"
    else
        out_info "Global install  (${GLOBAL_BIN}/${APP_NAME}):   not found"
    fi
    if [ -x "${USER_BIN}/${APP_NAME}" ]; then
        local_ver=$(grep '^VERSION="' "${USER_BIN}/${APP_NAME}" 2>/dev/null | cut -d'"' -f2 || echo "unknown")
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    ${local_ver}"
    else
        out_info "Local install   (${USER_BIN}/${APP_NAME}):    not found"
    fi
    out_empty_line
    local current_user
    current_user="$(id -un 2>/dev/null || echo "unknown")"
    out_info "Current user:      ${current_user}"
    if [ "$(id -u)" -eq 0 ]; then
        out_success "Execution context: root (global install path available)"
    else
        out_info "Execution context: this login (no root required for this CLI)"
    fi
    out_empty_line
    local current_shell
    current_shell=$(util_get_current_shell)
    out_info "Current shell:     ${current_shell}"
    if [ -t 1 ]; then
        out_info "TTY / Interactive: yes"
    else
        out_info "TTY / Interactive: no (non-interactive / scripted mode)"
    fi
    out_empty_line
    out_info "Storage (effective): ${EFFECTIVE_STORAGE_DIR}"
    out_info "Storage (fallback config field): ${STORAGE_DIR}"
    out_empty_line
    out_info "key store:         ${_root}/<username>/ssh-YYYYMMDD-N.tar.gz"
    out_info "key-adm account:   ${_adm} (present=${_adm_present})"
    out_empty_line
    out_info "Useful commands:"
    out_info "   ${APP_NAME} help           → Full usage"
    out_info "   ${APP_NAME} backup         → Archive this login ~/.ssh"
    out_info "   ${APP_NAME} restore        → Extract a dated archive"
    out_info "   ${APP_NAME} self-update    → Update to latest version"
    out_info "   ${APP_NAME} --json         → Machine-readable output"
    out_empty_line
    out_info "Run '${APP_NAME} help' for complete usage information."
    unset _root _adm _adm_present
}

app_version() {
    : "${APP_NAME:=key-cli}"
    : "${VERSION:=2.0.3}"
    : "${JSON:=0}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "version" "" "app" "${APP_NAME}" "version" "${VERSION}"
    else
        out_info "${APP_NAME} version ${VERSION}"
    fi
}

app_help() {
    : "${SHORT_DESCRIPTION:=${APP_DESC:-Backup and restore SSH user keys}}"
    : "${DESCRIPTION:=POSIX /bin/sh CLI: archive this login ~/.ssh into /var/key-cli, restore it, queue a public key for another account for key-adm to approve, and (as key-adm) do the same on behalf of other users.}"
    if [ "${JSON}" -eq 1 ]; then
        out_json "success" "Help text available in human-readable mode. Run without --json." \
            "command" "help" \
            "note" "Use --json with version, about, version-check, install, self-update, self-uninstall, rc-test."
        return 0
    fi
    if [ "${QUIET}" -eq 1 ]; then
        return 0
    fi
    out_info "${APP_NAME} — ${SHORT_DESCRIPTION}"
    out_plain "${DESCRIPTION}"
    out_empty_line
    out_info "Usage:"
    out_plain "  ${APP_NAME} [command] [options]"
    out_empty_line
    out_info "Self-management (this login):"
    out_plain "  install              Place ${APP_NAME}; ensure rc PATH"
    out_plain "  version              Show current version (TTY menu 82 runs about)"
    out_plain "  about                Show detailed diagnostics"
    out_plain "  version-check        Compare local vs remote version (needs SCRIPT_URL)"
    out_plain "  self-update          Update ${APP_NAME} to a newer remote version"
    out_plain "  self-uninstall       Remove ${APP_NAME} (safe PATH cleanup)"
    out_plain "  help                 Show this help"
    out_empty_line
    out_info "Domain commands (SSH user keys):"
    out_plain "  backup [user]        Archive /home/<user>/.ssh to /var/${APP_NAME}/<user>/ssh-YYYYMMDD-N.tar.gz (sudo; root:root)"
    out_plain "  restore list [user]  List dated archives for that user"
    out_plain "  restore [user] [archive]  Extract an archive back into /home/<user>/.ssh"
    out_plain "  auth-keys [list|add [user] <file>|request [user] <file>|pending|approve <file>|reject <file>|interactive]"
    out_plain "                      List or add authorized_keys; request queues a public key for another account; key-adm pending/approve/reject"
    out_plain "  setup                Root: create key-adm and F6 sudoers"
    out_plain "  remove-lpu           Root: remove key-adm (keeps /var/${APP_NAME} archives)"
    out_plain "  print-sudoers        Emit project-sudoers-file (draft) for admin install"
    out_plain "  print-sudoers-install-script  Write admin script for sudo install/uninstall/replace"
    out_plain "  generate-sudoer-request [path]  Independently write a JSON grant (backup/restore verbs)"
    out_plain "  submit-sudoer-request [file]  Queue a JSON sudoers-grant request via sudoer-cli"
    out_plain "  remove-project-sudoers [path]  Delete project-sudoers-file draft only"
    out_plain "  menu                 Numbered tree: 1 keys, 2 on-behalf (key-adm), 8 self-management, 9 Exit. Submenus 0 Back. Alias: main"
    out_empty_line
    out_info "Tests (local folder; not install):"
    out_plain "  rc-test              Prove PATH/profile/hook/symlink in --root tmp (--file bashrc|profile|hook|symlink --case create|modify|noop|rewrite). Does not write this login's real ~/.bashrc"
    out_empty_line
    out_info "Global Options:"
    out_plain "  --quiet, -q          Suppress info/success (errors and warnings still shown)"
    out_plain "  --json               Machine-readable JSON (implies --quiet)"
    out_plain "  --force              Force reinstall / skip uninstall confirm / allow restore overwrite"
    out_plain "  --debug              Debug diagnostics on stderr"
    out_empty_line
    : "${REPO_USER:=cloudgen}"
    : "${REPO_NAME:=key-cli}"
    : "${SCRIPT_URL:=}"
    : "${HOME:=/tmp}"
    : "${BASHRC:=${HOME}/.bashrc}"
    out_info "Environment:"
    out_plain "  REPO_USER            ${REPO_USER}"
    out_plain "                       GitHub owner used to compose default SCRIPT_URL"
    out_plain "  REPO_NAME            ${REPO_NAME}"
    out_plain "                       GitHub repo used to compose default SCRIPT_URL"
    if [ -n "${SCRIPT_URL}" ]; then
        out_plain "  SCRIPT_URL           ${SCRIPT_URL}"
    else
        out_plain "  SCRIPT_URL           (not set)"
    fi
    out_plain "                       Canonical install channel (override via env; needed for version-check/self-update)"
    out_plain "  BASHRC               ${BASHRC}"
    out_plain "                       Interactive rc written by install PATH ensure (default \${HOME}/.bashrc; override for tests/CI)"
    out_plain "  KEY_CLI_ROOT         durable store (default /var/${APP_NAME})"
    out_plain "  KEY_HOME_ROOT        parent of <user>/.ssh (default /home)"
    out_plain "  KEY_ADM_USER         least-privilege operator (default key-adm)"
    out_empty_line
}

app_main() {
    : "${COMMAND:=help}"
    : "${DOMAIN_OPERANDS:=}"
    : "${RC_TEST_OPERANDS:=}"
    : "${QUIET:=0}"
    : "${JSON:=0}"
    : "${DEBUG:=0}"
    : "${FORCE:=0}"
    : "${FORCE_REINSTALL:=0}"
    : "${USERNAME:=unknown}"
    : "${HOME:=/tmp}"
    : "${XDG_CACHE_HOME:=${HOME}/.cache}"
    : "${STORAGE_DIR:=${XDG_CACHE_HOME}/${APP_NAME}-${USERNAME}}"
    EFFECTIVE_STORAGE_DIR=$(util_resolve_storage)
    export EFFECTIVE_STORAGE_DIR STORAGE_DIR
    export TMPDIR="${EFFECTIVE_STORAGE_DIR}"
    key_heal_login_rc

    if [ $# -eq 0 ]; then
        if [ "${TTY}" -eq 1 ] && [ "${JSON}" -eq 0 ] && [ "${QUIET}" -eq 0 ]; then
            key_cmd_menu
            exit $?
        fi
        if [ "${JSON}" -eq 1 ] || [ "${QUIET}" -eq 1 ]; then
            inst_perform_install
            exit $?
        elif inst_is_installed; then
            inst_perform_install
            exit $?
        else
            inst_maybe_install
            exit $?
        fi
    fi

    while [ $# -gt 0 ]; do
        case "$1" in
            --quiet|-q) QUIET=1 ;;
            --json)     JSON=1; QUIET=1 ;;
            --debug)    DEBUG=1 ;;
            --force)    FORCE=1; FORCE_REINSTALL=1 ;;
            --allow-test-local)
                ALLOW_TEST_LOCAL_SUDOERS=1
                export ALLOW_TEST_LOCAL_SUDOERS
                ;;
            --update)
                SUBMIT_ACTION="update"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --add)
                SUBMIT_ACTION="add"
                SUBMIT_ACTION_EXPLICIT=1
                export SUBMIT_ACTION SUBMIT_ACTION_EXPLICIT
                ;;
            --purpose)
                if [ $# -lt 2 ]; then
                    out_die "--purpose requires TEXT"
                fi
                SUBMIT_PURPOSE="$2"
                export SUBMIT_PURPOSE
                shift
                ;;
            version|about|help|version-check|self-update|self-uninstall|install|rc-test)
                COMMAND="$1"
                ;;
            backup|restore|auth-keys|menu|main|setup|remove-lpu|print-sudoers|print-sudoers-install-script|generate-sudoer-request|submit-sudoer-request|remove-project-sudoers)
                case "${COMMAND}" in
                    backup|restore|auth-keys|print-sudoers|print-sudoers-install-script|generate-sudoer-request|submit-sudoer-request|remove-project-sudoers|setup|remove-lpu)
                        _op="$1"
                        if [ -n "${DOMAIN_OPERANDS}" ]; then
                            DOMAIN_OPERANDS="${DOMAIN_OPERANDS} ${_op}"
                        else
                            DOMAIN_OPERANDS="${_op}"
                        fi
                        unset _op
                        ;;
                    *)
                        COMMAND="$1"
                        ;;
                esac
                ;;
            *)
                case "${COMMAND}" in
                    rc-test)
                        if [ -n "${RC_TEST_OPERANDS}" ]; then
                            RC_TEST_OPERANDS="${RC_TEST_OPERANDS} $1"
                        else
                            RC_TEST_OPERANDS="$1"
                        fi
                        ;;
                    backup|restore|auth-keys|print-sudoers|print-sudoers-install-script|generate-sudoer-request|submit-sudoer-request|remove-project-sudoers|setup|remove-lpu)
                        _op="$1"
                        if [ -n "${DOMAIN_OPERANDS}" ]; then
                            DOMAIN_OPERANDS="${DOMAIN_OPERANDS} ${_op}"
                        else
                            DOMAIN_OPERANDS="${_op}"
                        fi
                        unset _op
                        ;;
                    *)
                        out_die "Unknown command or flag: $1. See '${APP_NAME} help'."
                        ;;
                esac
                ;;
        esac
        shift
    done

    out_debug "dispatch command=${COMMAND} quiet=${QUIET} json=${JSON} force=${FORCE}"

    case "${COMMAND}" in
        version)
            app_version
            ;;
        about)
            app_about
            ;;
        version-check)
            ver_check
            ;;
        self-update)
            inst_self_update
            ;;
        self-uninstall)
            inst_self_uninstall
            ;;
        install)
            inst_perform_install
            ;;
        rc-test)
            # shellcheck disable=SC2086
            set -- ${RC_TEST_OPERANDS}
            path_rc_test "$@"
            ;;
        backup)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_backup "${1-}"
            ;;
        restore)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_restore "${1-}" "${2-}"
            ;;
        auth-keys)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_auth_keys "${1:-list}" "${2-}" "${3-}"
            ;;
        menu|main) key_cmd_menu ;;
        setup) key_cmd_setup ;;
        remove-lpu) key_cmd_remove_lpu ;;
        print-sudoers)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_print_sudoers "${1-}"
            ;;
        print-sudoers-install-script)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_print_sudoers_install_script "${1-}"
            ;;
        generate-sudoer-request)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_generate_sudoer_request "${1-}"
            ;;
        submit-sudoer-request)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_submit_sudoer_request "${1-}"
            ;;
        remove-project-sudoers)
            set -- ${DOMAIN_OPERANDS}
            key_cmd_remove_project_sudoers "${1-}"
            ;;
        help|*)
            app_help
            ;;
    esac
}

# =============================================================================
# BOOTSTRAP
# =============================================================================
#
# Always invoke the single dispatcher. Do NOT gate on ${0##*/} matching APP_NAME:
# under curl | sh / stdin pipe, $0 is the shell (sh/bash/…), not the product
# filename — a basename gate causes silent no-op and breaks one-liner install.
# Product law: requirement-shell-cli-zero-arguments.md (TTY menu / non-TTY install) +
# requirement-shell-cli-interface.md (single app_main entry).
#
# Single-file install CLI: source-as-library is unsupported; main always runs.
# =============================================================================
app_main "$@"
